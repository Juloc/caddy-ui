DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Shared Netcup credentials. Keep the real values out of Git.
NETCUP_CUSTOMER_NUMBER=123456
NETCUP_API_KEY=replace-me
NETCUP_API_PASSWORD=replace-me

# Scheduled DDNS is configured on the DNS page after the first sign-in.

# Caddy UI
CADDY_UI_USERNAME=admin
CADDY_UI_PASSWORD=change-me-to-a-long-unique-password
CADDY_UI_SESSION_TTL=86400
CADDY_UI_PORTAL_SESSION_TTL=43200
CADDY_UI_PASSWORD_HASH_WORKERS=2

# Set this to the exact external HTTPS origin before exposing the UI through Caddy.
# Example: https://caddy.example.com
CADDY_UI_PUBLIC_ORIGIN=
CADDY_UI_SECURE_COOKIES=false

# Enable this only after TOTP is configured for every account that must sign in.
CADDY_UI_REQUIRE_TOTP=false

CADDY_ADMIN_URL=http://caddy:2019
CADDYFILE_PATH=/etc/caddy/Caddyfile
CADDY_ROUTES_DIR=/etc/caddy/routes
CADDY_DATA_PATH=/data
CADDY_LOG_PATH=/var/log/caddy/access.log
CADDY_UI_CONFIG_PATH=/etc/caddy/caddy-ui.json
CADDY_AUTO_RELOAD=true
UI_PORTAL_PORT=8099
