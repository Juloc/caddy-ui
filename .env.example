DOMAIN=example.com
ACME_EMAIL=admin@example.com

# PostgreSQL. Use long, unique values and keep the real .env out of Git.
CADDY_UI_DB_NAME=caddy_ui
CADDY_UI_DB_USER=caddy_ui
CADDY_UI_DB_PASSWORD=replace-with-a-long-random-database-password

# Initial administrator. Existing SQLite users are imported automatically.
CADDY_UI_USERNAME=admin
CADDY_UI_PASSWORD=replace-with-a-different-long-random-password
CADDY_UI_REQUIRE_TOTP=false
CADDY_UI_PUBLIC_ORIGIN=https://caddy.example.com
CADDY_UI_BIND_ADDRESS=0.0.0.0
CADDY_UI_ALLOW_CUSTOM_ROUTES=false

# Internal proxy authentication. Generate independent random values.
CADDY_UI_ADMIN_PROXY_SECRET=replace-with-a-long-random-admin-proxy-secret
CADDY_UI_PORTAL_PROXY_SECRET=replace-with-a-long-random-portal-proxy-secret

# Netcup DNS and ACME DNS-01.
NETCUP_CUSTOMER_NUMBER=123456
NETCUP_API_KEY=replace-me
NETCUP_API_PASSWORD=replace-me
