# Copy to deploy/shadow/.env and keep the real file out of Git.

# Local build identifier. The shadow stack builds Dockerfile.dotnet locally.
CADDY_UI_SHADOW_IMAGE_TAG=phase9-local

# Bind the administration UI only to loopback. Access it through SSH tunnelling.
CADDY_UI_SHADOW_ADMIN_PORT=18098

# Dedicated shadow PostgreSQL credentials.
CADDY_UI_SHADOW_DB_NAME=caddy_ui_shadow
CADDY_UI_SHADOW_DB_USER=caddy_ui_shadow
CADDY_UI_SHADOW_DB_PASSWORD=replace-with-a-long-random-password

# Bootstrap account for the isolated shadow UI.
CADDY_UI_SHADOW_ADMIN_USERNAME=admin
CADDY_UI_SHADOW_ADMIN_PASSWORD=replace-with-a-different-long-random-password

# Absolute host paths. Both are mounted read-only.
CADDY_UI_SHADOW_LOG_DIR=/absolute/path/to/caddy/logs
CADDY_UI_SHADOW_LEGACY_SQLITE=/absolute/path/to/caddy-ui.db

# The default access-log file expected below CADDY_UI_SHADOW_LOG_DIR.
CADDY_UI_SHADOW_ACCESS_LOG=access.log

# Shadow readiness gates.
CADDY_UI_SHADOW_MIN_HOURS=24
CADDY_UI_SHADOW_MAX_BACKUP_AGE_HOURS=24
CADDY_UI_SHADOW_TOLERANCE_PERCENT=5
