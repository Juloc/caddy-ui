@page
@model IndexModel
@{
    ViewData["Title"] = "Übersicht";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Caddy UI 2.0</p>
        <h1>Sicherer Parallelbetrieb</h1>
        <p class="page-description">
            Die Razor-Pages-Anwendung nutzt PostgreSQL, getrennte Admin- und Portal-Sitzungen sowie eine domainbasierte Routing-Grundlage.
        </p>
    </div>
    <span class="status-badge status-badge--ok">Phase 3</span>
</section>

<section class="metric-grid" aria-label="Systemstatus">
    <article class="metric-card">
        <span class="metric-label">Anwendung</span>
        <strong class="metric-value">@Model.Status.Product</strong>
        <span class="metric-detail">@Model.Status.Version</span>
    </article>
    <article class="metric-card">
        <span class="metric-label">Authentifizierung</span>
        <strong class="metric-value">2 Bereiche</strong>
        <span class="metric-detail">Admin und Access Portal</span>
    </article>
    <article class="metric-card">
        <span class="metric-label">Zertifikatstandard</span>
        <strong class="metric-value">Wildcard</strong>
        <span class="metric-detail">Einzelzertifikat nur explizit</span>
    </article>
    <article class="metric-card">
        <span class="metric-label">DNS-Katalog</span>
        <strong class="metric-value">18 Provider</strong>
        <span class="metric-detail">Secrets nur als Referenzen</span>
    </article>
</section>

<section class="workspace-grid">
    <article class="panel panel--wide">
        <header class="panel-header">
            <div>
                <p class="eyebrow">Phase 3</p>
                <h2>Ersetzte Sicherheitsgrundlage</h2>
            </div>
        </header>
        <div class="panel-body">
            <ul class="check-list">
                <li>Rollen Administrator, Editor und Viewer</li>
                <li>Getrennte LAN-, Public- und Portal-Sitzungen</li>
                <li>TOTP, Recovery-Codes und Legacy-scrypt-Rehash</li>
                <li>Persistente progressive Login-Sperren</li>
                <li>Origin-, CSRF- und Proxy-Surface-Prüfung</li>
                <li>Mehrere Domains mit Wildcard-Zertifikaten als Standard</li>
            </ul>
        </div>
    </article>

    <aside class="panel">
        <header class="panel-header">
            <div>
                <p class="eyebrow">Als Nächstes</p>
                <h2>Phase 4</h2>
            </div>
        </header>
        <div class="panel-body">
            <p>Log-Ingestion, Request-Klassifikation, Pageviews, Sessions und Aggregate werden als nächster Schritt umgesetzt.</p>
        </div>
    </aside>
</section>
