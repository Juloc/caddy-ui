@page
@model IndexModel
@{
    ViewData["Title"] = T["Overview"];
}
<section class="page-heading"><div><h1>@T["Traffic"]</h1></div><a class="button button--quiet" asp-page="/LiveLog/Index">@T["Live log"]</a></section>
<partial name="Shared/_AnalyticsFilters" model="Model" />
<div data-analytics-snapshot>
    <partial name="Shared/_TrafficSummary" model="Model.Dashboard" />
</div>
