@page
@model CaddyUi.Web.Pages.LoginModel
@{
    Layout = null;
    var culture = global::System.Globalization.CultureInfo.CurrentUICulture.Name;
}
<!DOCTYPE html>
<html lang="@culture" data-theme="system">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@T["Sign in"] · Caddy UI</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-card">
        <div class="auth-brand">
            <span class="brand-mark" aria-hidden="true">C</span>
            <div>
                <strong>Caddy UI</strong>
                <span>@T["Administration"]</span>
            </div>
        </div>

        <div>
            <h1>@T["Sign in"]</h1>
        </div>

        @if (Model.RequiresSecondFactor)
        {
            <form method="post" asp-page-handler="SecondFactor" class="form-stack">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All" class="validation-summary" role="alert" aria-live="polite"></div>
                <label>
                    <span>@T["TOTP or recovery code"]</span>
                    <input asp-for="SecondFactor.Code" inputmode="numeric" autocomplete="one-time-code" autofocus />
                    <span asp-validation-for="SecondFactor.Code" class="field-error"></span>
                </label>
                <button class="button button--primary" type="submit">@T["Verify code"]</button>
                <a href="@Url.Page("/Login", new { ReturnUrl = Model.ReturnUrl, Restart = true })">@T["Use a different account"]</a>
            </form>
        }
        else
        {
            <form method="post" class="form-stack">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All" class="validation-summary" role="alert" aria-live="polite"></div>
                <label>
                    <span>@T["Username"]</span>
                    <input asp-for="Input.Username" autocomplete="username" autofocus />
                    <span asp-validation-for="Input.Username" class="field-error"></span>
                </label>
                <label>
                    <span>@T["Password"]</span>
                    <input asp-for="Input.Password" type="password" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </label>
                <button class="button button--primary" type="submit">@T["Sign in"]</button>
            </form>
        }
    </main>
</body>
</html>
