@model CaddyUi.Web.Pages.AnalyticsPageModelBase
<form method="get" class="analytics-filters" aria-label="@T["Analytics filters"]">
    <label>
        <span>@T["Period"]</span>
        <select asp-for="Range">
            <option value="1h">@T["Last hour"]</option>
            <option value="24h">@T["Last 24 hours"]</option>
            <option value="7d">@T["Last 7 days"]</option>
            <option value="30d">@T["Last 30 days"]</option>
            <option value="90d">@T["Last 90 days"]</option>
        </select>
    </label>
    <label>
        <span>@T["Host"]</span>
        <select asp-for="Host">
            <option value="">@T["All hosts"]</option>
            @foreach (var host in Model.Hosts)
            {
                <option value="@host">@host</option>
            }
        </select>
    </label>
    <label>
        <span>@T["Actor"]</span>
        <select asp-for="Actor">
            <option value="">@T["All actors"]</option>
            <option value="human">@T["Human"]</option>
            <option value="bot">@T["Bot"]</option>
            <option value="internal">@T["Internal"]</option>
            <option value="unknown">@T["Unknown"]</option>
        </select>
    </label>
    <label>
        <span>@T["Request type"]</span>
        <select asp-for="Type">
            <option value="">@T["All types"]</option>
            <option value="document">@T["Document"]</option>
            <option value="asset">@T["Asset"]</option>
            <option value="api">API</option>
            <option value="websocket">WebSocket</option>
            <option value="healthcheck">@T["Health check"]</option>
            <option value="auth">@T["Authentication"]</option>
            <option value="system">@T["System"]</option>
            <option value="other">@T["Other"]</option>
        </select>
    </label>
    <label>
        <span>@T["Status"]</span>
        <select asp-for="Status">
            <option value="">@T["All status classes"]</option>
            <option value="2xx">2xx</option>
            <option value="3xx">3xx</option>
            <option value="4xx">4xx</option>
            <option value="5xx">5xx</option>
        </select>
    </label>
    <button class="button button--primary" type="submit">@T["Apply"]</button>
</form>
