@model CaddyUi.Web.Pages.AnalyticsPageModelBase
<form method="get" class="analytics-filters" aria-label="Analytics-Filter">
    <label>
        <span>Zeitraum</span>
        <select asp-for="Range">
            <option value="1h">Letzte Stunde</option>
            <option value="24h">Letzte 24 Stunden</option>
            <option value="7d">Letzte 7 Tage</option>
            <option value="30d">Letzte 30 Tage</option>
            <option value="90d">Letzte 90 Tage</option>
        </select>
    </label>
    <label>
        <span>Host</span>
        <select asp-for="Host">
            <option value="">Alle Hosts</option>
            @foreach (var host in Model.Hosts)
            {
                <option value="@host">@host</option>
            }
        </select>
    </label>
    <label>
        <span>Akteur</span>
        <select asp-for="Actor">
            <option value="">Alle Akteure</option>
            <option value="human">Human</option>
            <option value="bot">Bot</option>
            <option value="internal">Internal</option>
            <option value="unknown">Unknown</option>
        </select>
    </label>
    <label>
        <span>Requesttyp</span>
        <select asp-for="Type">
            <option value="">Alle Typen</option>
            <option value="document">Dokument</option>
            <option value="asset">Asset</option>
            <option value="api">API</option>
            <option value="websocket">WebSocket</option>
            <option value="healthcheck">Healthcheck</option>
            <option value="auth">Auth</option>
            <option value="system">System</option>
            <option value="other">Sonstige</option>
        </select>
    </label>
    <label>
        <span>Status</span>
        <select asp-for="Status">
            <option value="">Alle Statusklassen</option>
            <option value="2xx">2xx</option>
            <option value="3xx">3xx</option>
            <option value="4xx">4xx</option>
            <option value="5xx">5xx</option>
        </select>
    </label>
    <button class="button button--primary" type="submit">Anwenden</button>
</form>
