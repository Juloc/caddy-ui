@inject CaddyUi.Web.Security.SecurityRuntimeOptions SecurityOptions
@inject CaddyUi.Infrastructure.Routing.RoutingOptions RoutingOptions
<!DOCTYPE html>
<html lang="de" data-theme="system">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · Caddy UI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-page="/Index" aria-label="Caddy UI Übersicht">
                <span class="brand-mark" aria-hidden="true">C</span>
                <span><strong>Caddy UI</strong><small>.NET / PostgreSQL</small></span>
            </a>

            <nav class="primary-nav" aria-label="Hauptnavigation">
                <span class="nav-section">Überblick</span>
                <a class="nav-item @(Context.Request.Path == "/" ? "nav-item--active" : string.Empty)" asp-page="/Index"><span class="nav-icon">⌂</span><span>Übersicht</span></a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Traffic") ? "nav-item--active" : string.Empty)" asp-page="/Traffic/Index"><span class="nav-icon">↗</span><span>Traffic</span></a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Requests") ? "nav-item--active" : string.Empty)" asp-page="/Requests/Index"><span class="nav-icon">≡</span><span>Requests</span></a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Routes/Analytics") ? "nav-item--active" : string.Empty)" asp-page="/Routes/Analytics"><span class="nav-icon">⌘</span><span>Routenanalyse</span></a>

                @if (User.IsInRole("admin") || User.IsInRole("editor"))
                {
                    <span class="nav-section">Konfiguration</span>
                    <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Routing") ? "nav-item--active" : string.Empty)" asp-page="/Routing/Index"><span class="nav-icon">⇄</span><span>Routen</span></a>
                }
                @if (User.IsInRole("admin"))
                {
                    <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Administration/Domains") ? "nav-item--active" : string.Empty)" asp-page="/Administration/Domains"><span class="nav-icon">◎</span><span>Domains</span></a>
                    <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Access") ? "nav-item--active" : string.Empty)" asp-page="/Access/Index"><span class="nav-icon">▣</span><span>Zugriffsgruppen</span></a>
                }

                <span class="nav-section">Betrieb</span>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Security") ? "nav-item--active" : string.Empty)" asp-page="/Security/Overview"><span class="nav-icon">◇</span><span>Bots &amp; Sicherheit</span></a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Performance") ? "nav-item--active" : string.Empty)" asp-page="/Performance/Index"><span class="nav-icon">△</span><span>Fehler &amp; Performance</span></a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/LiveLog") ? "nav-item--active" : string.Empty)" asp-page="/LiveLog/Index"><span class="nav-icon">›_</span><span>Live-Log</span></a>
                <a class="nav-item @(Context.Request.Path.StartsWithSegments("/System") ? "nav-item--active" : string.Empty)" asp-page="/SystemStatus/Index"><span class="nav-icon">⚙</span><span>System</span></a>

                @if (User.IsInRole("admin"))
                {
                    <span class="nav-section">Administration</span>
                    <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Administration/Providers") ? "nav-item--active" : string.Empty)" asp-page="/Administration/Providers"><span class="nav-icon">DNS</span><span>DNS-Provider</span></a>
                    <a class="nav-item @(Context.Request.Path.StartsWithSegments("/Administration/Security") ? "nav-item--active" : string.Empty)" asp-page="/Administration/Security"><span class="nav-icon">🔒</span><span>Sicherheit</span></a>
                }
            </nav>

            <div class="sidebar-footer">
                <span class="connection-dot" aria-hidden="true"></span>
                <span>Phase 7 · @RoutingOptions.WriteMode.ToString().ToLowerInvariant()</span>
            </div>
        </aside>

        <div class="app-content">
            <header class="topbar">
                <div class="topbar-title"><span class="topbar-label">Arbeitsbereich</span><strong>@ViewData["Title"]</strong></div>
                <div class="topbar-actions">
                    @if (SecurityOptions.PublicAccessWithoutMandatoryTotp)
                    {
                        <span class="environment-chip environment-chip--warning">Public ohne TOTP-Pflicht</span>
                    }
                    <span class="environment-chip">@RoutingOptions.WriteMode.ToString().ToLowerInvariant()</span>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="user-chip">@User.Identity.Name · @User.FindFirst(global::System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        <form method="post" asp-page="/Logout"><button class="button button--compact button--quiet" type="submit">Abmelden</button></form>
                    }
                </div>
            </header>
            <main class="main-content">@RenderBody()</main>
            <footer class="app-statusbar"><span><i class="connection-dot"></i>Bereit</span><span>Routenmodus: @RoutingOptions.WriteMode.ToString().ToLowerInvariant()</span></footer>
        </div>
    </div>
</body>
</html>
