@{
    var path = Context.Request.Path;
    var version = global::System.Environment.GetEnvironmentVariable("CADDY_UI_VERSION")
        ?? global::CaddyUi.Domain.ProductMetadata.FoundationVersion;
}
<!DOCTYPE html>
<html lang="de" data-theme="system">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · Caddy UI</title>
    <script>
        (() => {
            try {
                const preference = localStorage.getItem("caddy-ui-theme");
                document.documentElement.dataset.theme = preference === "light" || preference === "dark" ? preference : "system";
            } catch {
                document.documentElement.dataset.theme = "system";
            }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <div class="app-shell" data-shell>
        <button class="mobile-navigation-button icon-button" type="button" data-mobile-navigation aria-controls="app-sidebar" aria-expanded="false" aria-label="Navigation öffnen">
            <svg aria-hidden="true"><use href="/icons/shell.svg#menu"></use></svg>
        </button>

        <aside id="app-sidebar" class="sidebar" data-sidebar aria-label="Seitennavigation">
            <div class="sidebar-header">
                <a class="brand" asp-page="/Index" aria-label="Caddy UI Übersicht">
                    <span class="brand-mark" aria-hidden="true">C</span>
                    <span class="brand-copy"><strong>Caddy UI</strong><small>Serververwaltung</small></span>
                </a>
                <button class="icon-button sidebar-collapse-button" type="button" data-sidebar-collapse aria-label="Seitenleiste einklappen" aria-pressed="false">
                    <svg aria-hidden="true"><use href="/icons/shell.svg#collapse"></use></svg>
                </button>
                <button class="icon-button sidebar-close-button" type="button" data-mobile-navigation-close aria-label="Navigation schließen">
                    <svg aria-hidden="true"><use href="/icons/shell.svg#close"></use></svg>
                </button>
            </div>

            <nav class="primary-nav" aria-label="Hauptnavigation">
                <span class="nav-section">Überblick</span>
                <a class="nav-item @(path == "/" ? "nav-item--active" : string.Empty)" asp-page="/Index" title="Übersicht"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#home"></use></svg><span class="nav-label">Übersicht</span></a>
                <a class="nav-item @(path.StartsWithSegments("/Traffic") ? "nav-item--active" : string.Empty)" asp-page="/Traffic/Index" title="Traffic"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#traffic"></use></svg><span class="nav-label">Traffic</span></a>
                <a class="nav-item @(path.StartsWithSegments("/Requests") ? "nav-item--active" : string.Empty)" asp-page="/Requests/Index" title="Requests"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#requests"></use></svg><span class="nav-label">Requests</span></a>
                <a class="nav-item @(path.StartsWithSegments("/Routes/Analytics") ? "nav-item--active" : string.Empty)" asp-page="/Routes/Analytics" title="Routenanalyse"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#chart"></use></svg><span class="nav-label">Routenanalyse</span></a>

                @if (User.IsInRole("admin") || User.IsInRole("editor"))
                {
                    <span class="nav-section">Konfiguration</span>
                    <a class="nav-item @(path.StartsWithSegments("/Routing") ? "nav-item--active" : string.Empty)" asp-page="/Routing/Index" title="Routen"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#route"></use></svg><span class="nav-label">Routen</span></a>
                }
                @if (User.IsInRole("admin"))
                {
                    <a class="nav-item @(path.StartsWithSegments("/Setup") ? "nav-item--active" : string.Empty)" asp-page="/Setup/Index" title="Einrichtung"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#setup"></use></svg><span class="nav-label">Einrichtung</span></a>
                    <a class="nav-item @(path.StartsWithSegments("/Administration/Providers") ? "nav-item--active" : string.Empty)" asp-page="/Administration/Providers" title="DNS-Provider"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#provider"></use></svg><span class="nav-label">DNS-Provider</span></a>
                    <a class="nav-item @(path.StartsWithSegments("/Administration/Domains") ? "nav-item--active" : string.Empty)" asp-page="/Administration/Domains" title="Domains und Zertifikate"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#domain"></use></svg><span class="nav-label">Domains &amp; Zertifikate</span></a>
                    <a class="nav-item @(path.StartsWithSegments("/Administration/Acme") ? "nav-item--active" : string.Empty)" asp-page="/Administration/Acme" title="ACME-Konto"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#domain"></use></svg><span class="nav-label">ACME-Konto</span></a>
                    <a class="nav-item @(path.StartsWithSegments("/Access") ? "nav-item--active" : string.Empty)" asp-page="/Access/Index" title="Zugriffsgruppen"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#access"></use></svg><span class="nav-label">Zugriffsgruppen</span></a>
                    <a class="nav-item @(path.StartsWithSegments("/Operations/Dns") ? "nav-item--active" : string.Empty)" asp-page="/Operations/Dns" title="DNS und DDNS"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#dns"></use></svg><span class="nav-label">DNS &amp; DDNS</span></a>
                }

                <span class="nav-section">Betrieb</span>
                <a class="nav-item @(path.StartsWithSegments("/Security") ? "nav-item--active" : string.Empty)" asp-page="/Security/Overview" title="Bots und Sicherheit"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#security"></use></svg><span class="nav-label">Bots &amp; Sicherheit</span></a>
                <a class="nav-item @(path.StartsWithSegments("/Performance") ? "nav-item--active" : string.Empty)" asp-page="/Performance/Index" title="Fehler und Performance"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#performance"></use></svg><span class="nav-label">Fehler &amp; Performance</span></a>
                <a class="nav-item @(path.StartsWithSegments("/LiveLog") ? "nav-item--active" : string.Empty)" asp-page="/LiveLog/Index" title="Live-Log"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#terminal"></use></svg><span class="nav-label">Live-Log</span></a>
                @if (User.IsInRole("admin"))
                {
                    <a class="nav-item @(path.StartsWithSegments("/Operations/Health") ? "nav-item--active" : string.Empty)" asp-page="/Operations/Health" title="Healthchecks"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#health"></use></svg><span class="nav-label">Healthchecks</span></a>
                    <a class="nav-item @(path.StartsWithSegments("/Operations/Jobs") ? "nav-item--active" : string.Empty)" asp-page="/Operations/Jobs" title="Jobs"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#jobs"></use></svg><span class="nav-label">Jobs</span></a>
                }
                <a class="nav-item @(path.StartsWithSegments("/System") ? "nav-item--active" : string.Empty)" asp-page="/SystemStatus/Index" title="System"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#system"></use></svg><span class="nav-label">System</span></a>

                @if (User.IsInRole("admin"))
                {
                    <span class="nav-section">Administration</span>
                    <a class="nav-item @(path.StartsWithSegments("/Operations/Notifications") ? "nav-item--active" : string.Empty)" asp-page="/Operations/Notifications" title="Benachrichtigungen"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#notifications"></use></svg><span class="nav-label">Benachrichtigungen</span></a>
                    <a class="nav-item @(path.StartsWithSegments("/Operations/Backup") ? "nav-item--active" : string.Empty)" asp-page="/Operations/Backup" title="Backup und Diagnose"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#backup"></use></svg><span class="nav-label">Backup &amp; Diagnose</span></a>
                    <a class="nav-item @(path.StartsWithSegments("/Operations/Cutover") ? "nav-item--active" : string.Empty)" asp-page="/Operations/Cutover" title="Migration und Rückfall"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#migration"></use></svg><span class="nav-label">Migration &amp; Rückfall</span></a>
                    <a class="nav-item @(path.StartsWithSegments("/Administration/Security") ? "nav-item--active" : string.Empty)" asp-page="/Administration/Security" title="Sicherheit"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#lock"></use></svg><span class="nav-label">Sicherheit</span></a>
                }
            </nav>

            <div class="sidebar-footer">
                <a class="nav-item sidebar-about @(path.StartsWithSegments("/About") ? "nav-item--active" : string.Empty)" asp-page="/About" title="Über Caddy UI"><svg class="nav-icon" aria-hidden="true"><use href="/icons/shell.svg#info"></use></svg><span class="nav-label">Über Caddy UI</span></a>
                <div class="sidebar-status" title="Installierte Version"><span class="connection-dot" aria-hidden="true"></span><span class="sidebar-status-label">Version</span><strong>@version</strong></div>
                <div class="sidebar-controls">
                    <div class="theme-selector" role="group" aria-label="Farbschema">
                        <button type="button" data-theme-option="system" aria-label="Systemdesign verwenden" title="System"><svg aria-hidden="true"><use href="/icons/shell.svg#system"></use></svg><span>System</span></button>
                        <button type="button" data-theme-option="light" aria-label="Helles Design verwenden" title="Hell"><svg aria-hidden="true"><use href="/icons/shell.svg#light"></use></svg><span>Hell</span></button>
                        <button type="button" data-theme-option="dark" aria-label="Dunkles Design verwenden" title="Dunkel"><svg aria-hidden="true"><use href="/icons/shell.svg#dark"></use></svg><span>Dunkel</span></button>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page="/Logout" class="logout-form">
                            <button type="submit" class="logout-button" title="Abmelden"><svg aria-hidden="true"><use href="/icons/shell.svg#logout"></use></svg><span>Abmelden</span></button>
                        </form>
                    }
                </div>
            </div>
        </aside>

        <button class="sidebar-backdrop" type="button" data-sidebar-backdrop aria-label="Navigation schließen"></button>
        <div class="app-content">
            <main id="main-content" class="main-content" tabindex="-1">@RenderBody()</main>
        </div>
    </div>

    <script src="~/js/shell.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
