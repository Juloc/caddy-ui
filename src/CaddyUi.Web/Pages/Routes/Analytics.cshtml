@page
@model CaddyUi.Web.Pages.Routes.AnalyticsModel
@{
    ViewData["Title"] = T["Route analytics"];
}
<section class="page-heading"><div><p class="eyebrow">@T["Normalized paths"]</p><h1>@T["Route analytics"]</h1><p class="page-description">@T["UUIDs, numbers, and long build tokens are normalized. Framework assets such as Nuxt remain technical requests and are not counted as page views."]</p></div><span class="status-badge status-badge--neutral">@T["{0} groups", Model.Routes.Count]</span></section>
<partial name="Shared/_AnalyticsFilters" model="Model" />
<section class="panel panel--wide"><div class="panel-body table-wrap">
<table class="data-table"><thead><tr><th>@T["Host / path"]</th><th>@T["Type"]</th><th>@T["Requests"]</th><th>@T["Errors"]</th><th>@T["Traffic"]</th><th>@T["Average duration"]</th><th>@T["Maximum"]</th></tr></thead><tbody>
@foreach (var route in Model.Routes)
{
<tr><td><strong>@route.Host</strong><small><code>@route.Path</code></small></td><td>@route.RequestType</td><td>@route.RequestCount.ToString("N0")</td><td>@route.ErrorCount.ToString("N0")</td><td>@AnalyticsPageModelBase.FormatBytes(route.BytesSent)</td><td>@AnalyticsPageModelBase.FormatDuration(route.AverageDurationMilliseconds)</td><td>@AnalyticsPageModelBase.FormatDuration(route.MaximumDurationMilliseconds)</td></tr>
}
</tbody></table>
@if (Model.Routes.Count == 0) { <p class="empty-state">@T["No route data matches the filter."]</p> }
</div></section>
