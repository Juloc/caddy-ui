@page
@model CaddyUi.Web.Pages.Routing.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Route bearbeiten" : "Neue Route";
}

<section class="page-heading page-heading--compact">
    <div>
        <p class="eyebrow">Routing-Editor</p>
        <h1>@ViewData["Title"]</h1>
        <p class="page-description">Klare Felder, keine direkte Caddy-Änderung. Speichern erzeugt erst einen verwalteten Entwurf.</p>
    </div>
    <a class="button button--quiet" asp-page="/Routing/Index">Zurück zu Routen</a>
</section>

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<form method="post" class="feature-route-editor" data-route-editor>
    <input asp-for="Input.Id" type="hidden" />

    <section class="workspace-section">
        <header class="section-header">
            <div><h2>Adresse und Verhalten</h2><p>Domain, Pfad und Routentyp legen fest, wann diese Regel greift.</p></div>
        </header>
        <div class="form-grid form-grid--three">
            <label class="field field--wide">
                <span class="field-label">Name</span>
                <input asp-for="Input.Name" autocomplete="off" placeholder="Mealie" />
                <span asp-validation-for="Input.Name" class="field-error"></span>
            </label>
            <label class="field">
                <span class="field-label">Domain</span>
                <select asp-for="Input.DomainId">
                    @foreach (var domain in Model.Domains.Where(item => item.Enabled))
                    {
                        <option value="@domain.Id">@domain.DisplayName · @domain.Name</option>
                    }
                </select>
                <span asp-validation-for="Input.DomainId" class="field-error"></span>
            </label>
            <label class="field">
                <span class="field-label">Subdomain</span>
                <input asp-for="Input.Subdomain" autocomplete="off" placeholder="mealie" />
                <small>Leer verwendet die Domain direkt.</small>
            </label>
            <label class="field">
                <span class="field-label">Pfadpräfix</span>
                <input asp-for="Input.PathPrefix" autocomplete="off" placeholder="/" />
                <span asp-validation-for="Input.PathPrefix" class="field-error"></span>
            </label>
            <label class="field">
                <span class="field-label">Routentyp</span>
                <select asp-for="Input.Kind" data-route-kind>
                    <option value="proxy">Reverse Proxy</option>
                    <option value="redirect">Weiterleitung</option>
                    <option value="static">Statische Antwort</option>
                    @if (Model.AllowCustomRoutes)
                    {
                        <option value="custom">Custom Caddyfile</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">Reihenfolge</span>
                <input asp-for="Input.SortOrder" type="number" />
                <small>Kleinere Werte werden zuerst generiert.</small>
            </label>
        </div>
    </section>

    <section class="workspace-section route-kind-panel" data-kind-panel="proxy">
        <header class="section-header">
            <div><h2>Reverse Proxy</h2><p>Ziel und optionale aktive Healthchecks.</p></div>
        </header>
        <div class="form-grid form-grid--three">
            <label class="field field--wide">
                <span class="field-label">Upstream</span>
                <input asp-for="Input.Upstream" autocomplete="off" placeholder="192.168.1.20:9925" />
                <small>Erlaubt: <code>host:port</code>, <code>http://host:port</code> oder <code>https://host:port</code>.</small>
            </label>
            <label class="field">
                <span class="field-label">Health-Pfad</span>
                <input asp-for="Input.HealthPath" autocomplete="off" placeholder="/health" />
            </label>
            <label class="field">
                <span class="field-label">Health-Intervall</span>
                <div class="input-with-suffix"><input asp-for="Input.HealthIntervalSeconds" type="number" min="5" max="3600" /><span>Sek.</span></div>
            </label>
            <label class="check field--wide">
                <input asp-for="Input.PreserveHost" />
                <span><strong>Originalen Host-Header beibehalten</strong><small>Nur aktivieren, wenn der Upstream den öffentlichen Host erwartet.</small></span>
            </label>
        </div>
    </section>

    <section class="workspace-section route-kind-panel" data-kind-panel="redirect">
        <header class="section-header"><div><h2>Weiterleitung</h2><p>Lokaler Pfad oder vollständige HTTP(S)-Adresse.</p></div></header>
        <div class="form-grid form-grid--two">
            <label class="field">
                <span class="field-label">Ziel</span>
                <input asp-for="Input.RedirectTarget" autocomplete="off" placeholder="https://example.com/new" />
            </label>
            <label class="check">
                <input asp-for="Input.RedirectPermanent" />
                <span><strong>Permanent (HTTP 308)</strong><small>Deaktiviert verwendet HTTP 302.</small></span>
            </label>
        </div>
    </section>

    <section class="workspace-section route-kind-panel" data-kind-panel="static">
        <header class="section-header"><div><h2>Statische Antwort</h2><p>Für Wartungshinweise, feste Statuscodes oder einfache Endpunkte.</p></div></header>
        <div class="form-grid form-grid--two">
            <label class="field">
                <span class="field-label">HTTP-Status</span>
                <input asp-for="Input.StaticStatusCode" type="number" min="100" max="599" />
            </label>
            <label class="field field--wide">
                <span class="field-label">Antworttext</span>
                <textarea asp-for="Input.StaticBody" rows="5" placeholder="Service temporarily unavailable"></textarea>
            </label>
        </div>
    </section>

    @if (Model.AllowCustomRoutes)
    {
        <section class="workspace-section route-kind-panel" data-kind-panel="custom">
            <header class="section-header"><div><h2>Custom Caddyfile</h2><p>Nur für Direktiven innerhalb eines bereits generierten <code>handle</code>-Blocks. Keine Site-Blöcke oder Secrets.</p></div></header>
            <label class="field">
                <span class="field-label">Direktiven</span>
                <textarea asp-for="Input.CustomSnippet" rows="12" class="code-editor" spellcheck="false"></textarea>
            </label>
        </section>
    }

    <section class="workspace-section">
        <header class="section-header"><div><h2>Zugriff und Zertifikat</h2><p>Öffentliche Route oder Anmeldung über das interne Access Portal.</p></div></header>
        <div class="form-grid form-grid--three">
            <label class="field">
                <span class="field-label">Zugriff</span>
                <select asp-for="Input.AccessGroupId">
                    <option value="">Öffentlich</option>
                    @foreach (var group in Model.AccessGroups)
                    {
                        <option value="@group.Id">@group.Name</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">Zertifikat</span>
                <select asp-for="Input.CertificateMode">
                    <option value="inherit">Von Domain erben</option>
                    <option value="wildcard">Wildcard</option>
                    <option value="individual">Einzelzertifikat</option>
                </select>
            </label>
            <label class="check">
                <input asp-for="Input.Enabled" />
                <span><strong>In nächste Revision aufnehmen</strong><small>Aktiviert nicht sofort die laufende Caddy-Konfiguration.</small></span>
            </label>
        </div>
    </section>

    <footer class="editor-actionbar">
        <div><strong>Speichern ist sicher.</strong><span>Preview und Apply bleiben ein separater, geprüfter Schritt.</span></div>
        <div class="page-actions">
            <a class="button button--quiet" asp-page="/Routing/Index">Abbrechen</a>
            <button class="button button--primary" type="submit">Route speichern</button>
        </div>
    </footer>
</form>

<script>
(() => {
    const editor = document.querySelector('[data-route-editor]');
    if (!editor) return;
    const selector = editor.querySelector('[data-route-kind]');
    const update = () => {
        editor.querySelectorAll('[data-kind-panel]').forEach(panel => {
            panel.hidden = panel.dataset.kindPanel !== selector.value;
        });
    };
    selector.addEventListener('change', update);
    update();
})();
</script>
