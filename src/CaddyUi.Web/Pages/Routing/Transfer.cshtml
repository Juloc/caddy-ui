@page
@model CaddyUi.Web.Pages.Routing.TransferModel
@{
    ViewData["Title"] = T["Import and export routes"];
}

<section class="page-heading page-heading--compact">
    <div>
        <p class="eyebrow">@T["Portable route state"]</p>
        <h1>@T["Import and export"]</h1>
        <p class="page-description">@T["Exports only route configuration values. Passwords, provider secrets, sessions, and active Caddy snapshots are not included."]</p>
    </div>
    <a class="button button--quiet" asp-page="/Routing/Index">@T["Back to routes"]</a>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice notice--ok" role="status">@Model.StatusMessage</div>
}
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="workspace-split workspace-split--wide-left">
    <article class="workspace-section">
        <header class="section-header">
            <div>
                <h2>@T["Export"]</h2>
                <p>@T["{0} routes in schema", Model.RouteCount] <code>caddy-ui-routes-v1</code>.</p>
            </div>
            <a class="button button--primary" asp-page-handler="Download">@T["Download JSON"]</a>
        </header>
        <div class="panel-body">
            <div class="notice notice--neutral">@T["The export contains domain names and access group names as references. The target installation must already contain them."]</div>
            <textarea class="code-editor transfer-preview" rows="20" readonly spellcheck="false">@Model.ExportPreview</textarea>
        </div>
    </article>

    <aside class="workspace-section">
        <header class="section-header">
            <div><h2>@T["Import"]</h2><p>@T["The complete import runs in one PostgreSQL transaction."]</p></div>
        </header>
        <form method="post" asp-page-handler="Import" class="form-stack panel-body">
            <label class="field">
                <span class="field-label">@T["Routes JSON"]</span>
                <textarea asp-for="Input.Json" rows="20" class="code-editor" spellcheck="false" placeholder="{ &quot;schema&quot;: &quot;caddy-ui-routes-v1&quot;, ... }"></textarea>
                <span asp-validation-for="Input.Json" class="field-error"></span>
            </label>
            <div class="notice notice--warning">@T["Existing active targets are not overwritten. If any error occurs, no route is imported."]</div>
            <button class="button button--primary" type="submit">@T["Validate and import routes"]</button>
        </form>
    </aside>
</section>

<section class="workspace-section transfer-contract">
    <header class="section-header"><div><h2>@T["Security boundaries"]</h2><p>@T["Import is a draft step, not a deployment."]</p></div></header>
    <div class="panel-body">
        <ul class="check-list">
            <li>@T["Domains and access groups must already exist and be enabled."]</li>
            <li>@T["Host, path, upstream, port, and certificate mode are validated again."]</li>
            <li>@T["Custom routes are rejected unless explicitly enabled."]</li>
            <li>@T["The running Caddy configuration changes only through preview and apply."]</li>
        </ul>
    </div>
</section>
