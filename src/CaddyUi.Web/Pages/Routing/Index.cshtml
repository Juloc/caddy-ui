@page
@using CaddyUi.Domain.Routing
@using Microsoft.Extensions.Localization
@model CaddyUi.Web.Pages.Routing.IndexModel
@inject IStringLocalizer<CaddyUi.Web.RoutingResource> R
@{
    ViewData["Title"] = T["Routes"];
}

<section class="page-heading page-heading--compact">
    <div>
        <p class="eyebrow">@T["Routing"]</p>
        <h1>@T["Routes"]</h1>
        <p class="page-description">@R["Manage services by domain. New standard routes only need a name and an upstream target."]</p>
    </div>
    <div class="page-actions">
        <a class="button button--quiet" asp-page="/Administration/Domains">@T["Domains"]</a>
        <a class="button button--quiet" asp-page="/Routing/Preview">@R["Preview and apply"]</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice notice--ok" role="status">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="notice notice--danger" role="alert">@Model.ErrorMessage</div>
}
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

@if (!Model.RuntimeState.ActiveStateTracked)
{
    <div class="notice notice--warning" role="status">
        @R["The active Caddy configuration does not match a known revision. Runtime state cannot be safely assigned to individual routes."]
        <a asp-page="/Routing/Preview">@R["Review preview"]</a>
    </div>
}
else if (Model.RuntimeState.LastApplyFailed)
{
    <div class="notice notice--danger" role="alert">
        @R["Applying the current changes failed. The previous Caddy configuration remains active."]
        @if (!string.IsNullOrWhiteSpace(Model.RuntimeState.LastApplyError))
        {
            <span>@Model.RuntimeState.LastApplyError</span>
        }
        <a asp-page="/Routing/Preview">@R["Preview and apply"]</a>
    </div>
}
else if (Model.RuntimeState.HasPendingChanges)
{
    <div class="notice notice--warning" role="status">
        @R["Saved changes are not fully active in Caddy yet."]
        <a asp-page="/Routing/Preview">@R["Preview and apply"]</a>
    </div>
}

<section class="route-overview" aria-label="@R["Domain routes"]">
    <header class="route-overview-header">
        <div>
            <strong>@R["{0} domains", Model.DomainGroups.Count]</strong>
            <span>· @R["{0} routes", Model.Routes.Count]</span>
            @if (Model.RuntimeState.ActiveStateTracked)
            {
                <span>· @R["{0} active in Caddy", Model.RuntimeState.ActiveRouteCount]</span>
            }
            else
            {
                <span>· @R["Active state unknown"]</span>
            }
        </div>
        <details class="route-overview-more">
            <summary class="button button--compact button--quiet">@R["More options"]</summary>
            <nav aria-label="@R["More routing options"]">
                <a asp-page="/Routing/Edit">@R["Create advanced route"]</a>
                <a asp-page="/Routing/Transfer">@R["Import / Export"]</a>
            </nav>
        </details>
    </header>

    <div class="domain-route-stack">
        @foreach (var group in Model.DomainGroups)
        {
            var dialogId = $"quick-route-{group.Domain.Id:N}";
            var formId = $"quick-route-form-{group.Domain.Id:N}";
            var restoreQuickValues = Model.QuickCreateDialogDomainId == group.Domain.Id && !ViewData.ModelState.IsValid;
            <section class="domain-route-group" data-domain-route-group>
                <header class="domain-route-header">
                    <div class="domain-route-heading">
                        <div class="domain-route-title">
                            <h2>@group.Domain.Name</h2>
                            @if (group.Domain.IsDefault)
                            {
                                <span class="status-badge status-badge--ok">@R["Default"]</span>
                            }
                            @if (!group.Domain.Enabled)
                            {
                                <span class="status-badge status-badge--neutral">@R["Disabled"]</span>
                            }
                        </div>
                        @if (!string.Equals(group.Domain.DisplayName, group.Domain.Name, StringComparison.OrdinalIgnoreCase))
                        {
                            <span>@group.Domain.DisplayName</span>
                        }
                        @if (Model.RuntimeState.ActiveStateTracked)
                        {
                            <small>@R["{0} routes · {1} active in Caddy", group.Routes.Count, Model.ActiveRouteCount(group.Routes)]</small>
                        }
                        else
                        {
                            <small>@R["{0} routes · active state unknown", group.Routes.Count]</small>
                        }
                    </div>
                    @if (group.Domain.Enabled)
                    {
                        <a class="button button--primary domain-route-add"
                           asp-page="/Routing/Index"
                           asp-route-quickDomain="@group.Domain.Id"
                           data-dialog-open="@dialogId">@R["+ Route"]</a>
                    }
                </header>

                @if (group.Routes.Count == 0)
                {
                    <div class="domain-route-empty">
                        <span>@R["No route exists for this domain yet."]</span>
                    </div>
                }
                else
                {
                    <ul class="domain-route-list">
                        @foreach (var route in group.Routes)
                        {
                            var definition = route.Definition;
                            var target = definition.Kind switch
                            {
                                ManagedRouteKind.Proxy => definition.Configuration.Upstream,
                                ManagedRouteKind.Redirect => definition.Configuration.RedirectTarget,
                                ManagedRouteKind.StaticResponse => $"HTTP {definition.Configuration.StaticStatusCode}",
                                ManagedRouteKind.Custom => R["Custom Caddyfile"].Value,
                                _ => string.Empty,
                            };
                            var runtimeState = Model.StateFor(definition.Id);
                            var actionsLabel = R["Actions for {0}", definition.Name];
                            var deleteConfirmation = R["Really delete route '{0}'?", definition.Name];
                            <li class="domain-route-row @(definition.Enabled ? null : "domain-route-row--disabled")">
                                <div class="domain-route-address">
                                    <strong>@definition.Host</strong>
                                    <small>@definition.Name@if (definition.Configuration.PathPrefix != "/") { <text> · @definition.Configuration.PathPrefix</text> }</small>
                                </div>
                                <div class="domain-route-target">
                                    <span aria-hidden="true">→</span>
                                    <code>@target</code>
                                </div>
                                <div class="domain-route-state">
                                    @if (!string.IsNullOrWhiteSpace(route.AccessGroupName))
                                    {
                                        <span class="status-badge status-badge--neutral">@route.AccessGroupName</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-badge--neutral">@R["Public"]</span>
                                    }
                                    <span class="status-badge @IndexModel.StateBadgeClass(runtimeState)">
                                        @R[IndexModel.StateLabelKey(runtimeState)]
                                    </span>
                                </div>
                                <div class="domain-route-actions">
                                    @if (IndexModel.CanOpen(definition, runtimeState))
                                    {
                                        <a class="button button--compact button--quiet"
                                           href="@IndexModel.PublicUrl(definition)"
                                           target="_blank"
                                           rel="noopener noreferrer">@R["Open"] ↗</a>
                                    }
                                    <a class="button button--compact button--quiet" asp-page="/Routing/Edit" asp-route-id="@definition.Id">@R["Edit"]</a>
                                    <details class="route-row-menu">
                                        <summary class="button button--compact button--quiet" aria-label="@actionsLabel">⋯</summary>
                                        <div class="route-row-menu-items">
                                            <a asp-page="/Routes/Analytics" asp-route-routeId="@definition.Id">@R["Statistics"]</a>
                                            <form method="post" asp-page-handler="Toggle" asp-antiforgery="true">
                                                <input type="hidden" name="id" value="@definition.Id" />
                                                <input type="hidden" name="enabled" value="@(!definition.Enabled)" />
                                                <button type="submit">@(definition.Enabled ? R["Disable"] : R["Enable"])</button>
                                            </form>
                                            <form method="post"
                                                  asp-page-handler="Delete"
                                                  asp-antiforgery="true"
                                                  data-confirm="@deleteConfirmation">
                                                <input type="hidden" name="id" value="@definition.Id" />
                                                <button class="route-row-delete" type="submit">@R["Delete"]</button>
                                            </form>
                                        </div>
                                    </details>
                                </div>
                            </li>
                        }
                    </ul>
                }

                @if (group.Domain.Enabled)
                {
                    <footer class="domain-route-footer">
                        <a asp-page="/Routing/Index"
                           asp-route-quickDomain="@group.Domain.Id"
                           data-dialog-open="@dialogId">@R["+ Add route"]</a>
                    </footer>
                }
            </section>

            @if (group.Domain.Enabled)
            {
                <dialog id="@dialogId"
                        class="dialog-surface"
                        data-dialog
                        aria-labelledby="@($"{dialogId}-title")"
                        open="@(Model.QuickCreateDialogDomainId == group.Domain.Id ? "open" : null)">
                    <div class="dialog-layout">
                        <header class="dialog-header">
                            <div>
                                <h2 id="@($"{dialogId}-title")">@R["New route for {0}", group.Domain.Name]</h2>
                                <p>@R["The subdomain is generated automatically from the route name."]</p>
                            </div>
                            <a class="button button--compact button--quiet" asp-page="/Routing/Index" data-dialog-close>@R["Close"]</a>
                        </header>
                        <div class="dialog-body">
                            <form id="@formId"
                                  method="post"
                                  asp-page-handler="QuickCreate"
                                  asp-antiforgery="true"
                                  class="form-stack">
                                <input type="hidden" name="QuickRoute.DomainId" value="@group.Domain.Id" />
                                <label class="field">
                                    <span class="field-label">@R["Route name"]</span>
                                    <input name="QuickRoute.Name"
                                           value="@(restoreQuickValues ? Model.QuickRoute.Name : string.Empty)"
                                           maxlength="120"
                                           autocomplete="off"
                                           placeholder="Home Assistant"
                                           required />
                                    <small>@R["Example: “Home Assistant” becomes"] <code>home-assistant.@group.Domain.Name</code>.</small>
                                    <span asp-validation-for="QuickRoute.Name" class="field-error"></span>
                                </label>
                                <label class="field">
                                    <span class="field-label">@R["Upstream"]</span>
                                    <input name="QuickRoute.Upstream"
                                           value="@(restoreQuickValues ? Model.QuickRoute.Upstream : string.Empty)"
                                           maxlength="2048"
                                           autocomplete="off"
                                           placeholder="http://homeassistant:8123"
                                           required />
                                    <small>@R["Hostname or internal URL of the service."]</small>
                                    <span asp-validation-for="QuickRoute.Upstream" class="field-error"></span>
                                </label>
                                <div class="safe-apply-note">
                                    <strong>@R["Wildcard automatically"]</strong>
                                    <span>@R["Save leaves the active Caddy configuration unchanged. When activating, the route is fully validated."]</span>
                                </div>
                            </form>
                        </div>
                        <footer class="dialog-footer quick-route-dialog-footer">
                            <a class="button button--quiet"
                               asp-page="/Routing/Edit"
                               asp-route-domainId="@group.Domain.Id">@R["Advanced"]</a>
                            <a class="button button--quiet" asp-page="/Routing/Index" data-dialog-close>@R["Cancel"]</a>
                            <button class="button"
                                    type="submit"
                                    form="@formId"
                                    name="applyAfterSave"
                                    value="false">@R["Save"]</button>
                            <button class="button button--primary"
                                    type="submit"
                                    form="@formId"
                                    name="applyAfterSave"
                                    value="true">@R["Create and activate"]</button>
                        </footer>
                    </div>
                </dialog>
            }
        }

        @if (Model.DomainGroups.Count == 0)
        {
            <div class="empty-state route-domain-empty">
                <strong>@R["No domain configured yet."]</strong>
                <span>@R["Create a domain first. Then you can add routes directly below it."]</span>
                <a class="button button--primary" asp-page="/Administration/Domains" asp-route-create-domain="1">@R["Add domain"]</a>
            </div>
        }
    </div>

    @if (Model.RuntimeState.PendingRemovals.Count > 0)
    {
        <section class="domain-route-group" aria-label="@R["Deleted routes still active"]">
            <header class="domain-route-header">
                <div class="domain-route-heading">
                    <div class="domain-route-title">
                        <h2>@R["Still active in Caddy"]</h2>
                        <span class="status-badge status-badge--warning">@R["Removal pending"]</span>
                    </div>
                    <small>@R["These routes were deleted but remain active until the next apply."]</small>
                </div>
                <a class="button button--primary" asp-page="/Routing/Preview">@R["Preview and apply"]</a>
            </header>
            <ul class="domain-route-list">
                @foreach (var pending in Model.RuntimeState.PendingRemovals)
                {
                    <li class="domain-route-row domain-route-row--disabled">
                        <div class="domain-route-address">
                            <strong>@pending.Host</strong>
                            <small>@pending.Name@if (pending.Path != "/") { <text> · @pending.Path</text> }</small>
                        </div>
                        <div class="domain-route-target">
                            <span aria-hidden="true">→</span>
                            <code>@R["deleted from database"]</code>
                        </div>
                        <div class="domain-route-state">
                            <span class="status-badge status-badge--warning">@R["Removal pending"]</span>
                        </div>
                        <div class="domain-route-actions">
                            <a class="button button--compact button--quiet" asp-page="/Routing/Preview">@R["Apply"]</a>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
</section>
