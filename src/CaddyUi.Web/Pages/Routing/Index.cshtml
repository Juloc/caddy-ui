@page
@model CaddyUi.Web.Pages.Routing.IndexModel
@using CaddyUi.Domain.Routing
@{
    ViewData["Title"] = T["Routes"];
}

<section class="page-heading page-heading--compact">
    <div>
        <p class="eyebrow">@T["Caddy configuration"]</p>
        <h1>@T["Routes"]</h1>
        <p class="page-description">@T["Routes are saved first, validated as a complete configuration, and only then applied in a controlled operation."]</p>
    </div>
    <div class="page-actions">
        <a class="button button--quiet" asp-page="/Routing/Transfer">@T["Import and export"]</a>
        <a class="button button--quiet" asp-page="/Routing/Preview">@T["Preview and apply"]</a>
        <a class="button button--primary" asp-page="/Routing/Edit">@T["New route"]</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice notice--ok" role="status">@Model.StatusMessage</div>
}
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="workspace-toolbar" aria-label="@T["Route status"]">
    <div class="toolbar-group">
        <span class="toolbar-label">@T["Write mode"]</span>
        <span class="status-badge @(Model.RoutingOptions.WriteMode == CaddyUi.Infrastructure.Routing.RouteWriteMode.Active ? "status-badge--warning" : "status-badge--neutral")">@Model.RoutingOptions.WriteMode.ToString().ToLowerInvariant()</span>
        <span class="toolbar-separator"></span>
        <span class="toolbar-summary">@T["{0} routes · {1} enabled", Model.Routes.Count, Model.Routes.Count(route => route.Definition.Enabled)]</span>
    </div>
    @if (User.IsInRole("admin"))
    {
        <div class="toolbar-group">
            <a class="button button--compact button--quiet" asp-page="/Administration/Domains">@T["Domains"]</a>
            <a class="button button--compact button--quiet" asp-page="/Access/Index">@T["Access groups"]</a>
        </div>
    }
</section>

<section class="workspace-section feature-routing-list">
    <header class="section-header">
        <div>
            <h2>@T["Managed routes"]</h2>
            <p>@T["Enabled only means that the route is included in the next generated revision. It does not write to Caddy immediately."]</p>
        </div>
    </header>
    <div class="table-wrap">
        <table class="data-table data-table--comfortable">
            <thead>
                <tr>
                    <th>@T["Route"]</th>
                    <th>@T["Target"]</th>
                    <th>@T["Access"]</th>
                    <th>@T["Status"]</th>
                    <th class="table-actions">@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Routes)
            {
                var route = item.Definition;
                <tr class="@(route.Enabled ? string.Empty : "is-muted")">
                    <td>
                        <a class="table-primary-link" asp-page="/Routing/Edit" asp-route-id="@route.Id">@route.Name</a>
                        <small><code>@route.Host@route.Configuration.PathPrefix</code></small>
                        <div class="inline-meta">
                            <span>@ManagedRouteDefinition.ToStorageValue(route.Kind)</span>
                            <span>@T["Order {0}", route.SortOrder]</span>
                            <span>@ManagedRouteDefinition.ToStorageValue(route.CertificateMode)</span>
                        </div>
                    </td>
                    <td>
                        @switch (route.Kind)
                        {
                            case ManagedRouteKind.Proxy:
                                <strong>@route.Configuration.Upstream</strong>
                                @if (route.Configuration.HealthPath.Length > 0)
                                {
                                    <small>@T["Health"]: @route.Configuration.HealthPath · @route.Configuration.HealthIntervalSeconds @T["sec."]</small>
                                }
                                break;
                            case ManagedRouteKind.Redirect:
                                <strong>@route.Configuration.RedirectTarget</strong>
                                <small>@(route.Configuration.RedirectPermanent ? T["308 permanent"] : T["302 temporary"])</small>
                                break;
                            case ManagedRouteKind.StaticResponse:
                                <strong>HTTP @route.Configuration.StaticStatusCode</strong>
                                <small>@T["Static response"]</small>
                                break;
                            case ManagedRouteKind.Custom:
                                <strong>@T["Custom directives"]</strong>
                                <small>@T["Advanced mode"]</small>
                                break;
                        }
                    </td>
                    <td>
                        @if (route.AccessGroupId is null)
                        {
                            <span class="status-badge status-badge--neutral">@T["Public"]</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge--info">@item.AccessGroupName</span>
                        }
                    </td>
                    <td>
                        <span class="status-badge @(route.Enabled ? "status-badge--ok" : "status-badge--neutral")">@(route.Enabled ? T["Enabled"] : T["Disabled"])</span>
                        <small>@T["Changed"] <time datetime="@item.UpdatedAt.ToString("O")" data-local-time>@item.UpdatedAt.ToString("u")</time></small>
                    </td>
                    <td class="table-actions">
                        <div class="row-actions">
                            <a class="button button--compact button--quiet" asp-page="/Routing/Edit" asp-route-id="@route.Id">@T["Edit"]</a>
                            <form method="post" asp-page-handler="Toggle">
                                <input type="hidden" name="id" value="@route.Id" />
                                <input type="hidden" name="enabled" value="@(!route.Enabled)" />
                                <button class="button button--compact button--quiet" type="submit">@(route.Enabled ? T["Disable"] : T["Enable"])</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" data-confirm="@T["Delete this route from management permanently? The active Caddy configuration remains unchanged until the next apply."]">
                                <input type="hidden" name="id" value="@route.Id" />
                                <button class="button button--compact button--danger-quiet" type="submit">@T["Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Routes.Count == 0)
            {
                <tr><td colspan="5" class="empty-state">@T["No route has been created yet."]</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
