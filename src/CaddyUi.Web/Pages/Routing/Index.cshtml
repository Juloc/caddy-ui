@page
@model CaddyUi.Web.Pages.Routing.IndexModel
@using CaddyUi.Domain.Routing
@{
    ViewData["Title"] = "Routen";
}

<section class="page-heading page-heading--compact">
    <div>
        <p class="eyebrow">Caddy-Konfiguration</p>
        <h1>Routen</h1>
        <p class="page-description">Routen werden zuerst gespeichert, anschließend als vollständige Konfiguration geprüft und erst danach kontrolliert angewendet.</p>
    </div>
    <div class="page-actions">
        <a class="button button--quiet" asp-page="/Routing/Transfer">Import &amp; Export</a>
        <a class="button button--quiet" asp-page="/Routing/Preview">Preview &amp; Apply</a>
        <a class="button button--primary" asp-page="/Routing/Edit">Neue Route</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice notice--ok" role="status">@Model.StatusMessage</div>
}
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="workspace-toolbar" aria-label="Routenstatus">
    <div class="toolbar-group">
        <span class="toolbar-label">Write Mode</span>
        <span class="status-badge @(Model.RoutingOptions.WriteMode == CaddyUi.Infrastructure.Routing.RouteWriteMode.Active ? "status-badge--warning" : "status-badge--neutral")">@Model.RoutingOptions.WriteMode.ToString().ToLowerInvariant()</span>
        <span class="toolbar-separator"></span>
        <span class="toolbar-summary">@Model.Routes.Count Routen · @Model.Routes.Count(route => route.Definition.Enabled) aktiv</span>
    </div>
    @if (User.IsInRole("admin"))
    {
        <div class="toolbar-group">
            <a class="button button--compact button--quiet" asp-page="/Administration/Domains">Domains</a>
            <a class="button button--compact button--quiet" asp-page="/Access/Index">Zugriffsgruppen</a>
        </div>
    }
</section>

<section class="workspace-section feature-routing-list">
    <header class="section-header">
        <div>
            <h2>Verwaltete Routen</h2>
            <p>Aktiv bedeutet nur: in der nächsten generierten Revision enthalten. Es schreibt nicht sofort nach Caddy.</p>
        </div>
    </header>
    <div class="table-wrap">
        <table class="data-table data-table--comfortable">
            <thead>
                <tr>
                    <th>Route</th>
                    <th>Ziel</th>
                    <th>Zugriff</th>
                    <th>Status</th>
                    <th class="table-actions">Aktionen</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Routes)
            {
                var route = item.Definition;
                <tr class="@(route.Enabled ? string.Empty : "is-muted")">
                    <td>
                        <a class="table-primary-link" asp-page="/Routing/Edit" asp-route-id="@route.Id">@route.Name</a>
                        <small><code>@route.Host@route.Configuration.PathPrefix</code></small>
                        <div class="inline-meta">
                            <span>@ManagedRouteDefinition.ToStorageValue(route.Kind)</span>
                            <span>Reihenfolge @route.SortOrder</span>
                            <span>@ManagedRouteDefinition.ToStorageValue(route.CertificateMode)</span>
                        </div>
                    </td>
                    <td>
                        @switch (route.Kind)
                        {
                            case ManagedRouteKind.Proxy:
                                <strong>@route.Configuration.Upstream</strong>
                                @if (route.Configuration.HealthPath.Length > 0)
                                {
                                    <small>Health: @route.Configuration.HealthPath · @route.Configuration.HealthIntervalSeconds s</small>
                                }
                                break;
                            case ManagedRouteKind.Redirect:
                                <strong>@route.Configuration.RedirectTarget</strong>
                                <small>@(route.Configuration.RedirectPermanent ? "308 permanent" : "302 temporary")</small>
                                break;
                            case ManagedRouteKind.StaticResponse:
                                <strong>HTTP @route.Configuration.StaticStatusCode</strong>
                                <small>Statische Antwort</small>
                                break;
                            case ManagedRouteKind.Custom:
                                <strong>Benutzerdefinierte Direktiven</strong>
                                <small>Erweiterter Modus</small>
                                break;
                        }
                    </td>
                    <td>
                        @if (route.AccessGroupId is null)
                        {
                            <span class="status-badge status-badge--neutral">Öffentlich</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge--info">@item.AccessGroupName</span>
                        }
                    </td>
                    <td>
                        <span class="status-badge @(route.Enabled ? "status-badge--ok" : "status-badge--neutral")">@(route.Enabled ? "Aktiv" : "Deaktiviert")</span>
                        <small>Geändert @item.UpdatedAt.ToLocalTime().ToString("g")</small>
                    </td>
                    <td class="table-actions">
                        <div class="row-actions">
                            <a class="button button--compact button--quiet" asp-page="/Routing/Edit" asp-route-id="@route.Id">Bearbeiten</a>
                            <form method="post" asp-page-handler="Toggle">
                                <input type="hidden" name="id" value="@route.Id" />
                                <input type="hidden" name="enabled" value="@(!route.Enabled)" />
                                <button class="button button--compact button--quiet" type="submit">@(route.Enabled ? "Deaktivieren" : "Aktivieren")</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Route endgültig aus der Verwaltung löschen? Die aktive Caddy-Konfiguration bleibt bis zum nächsten Apply unverändert.');">
                                <input type="hidden" name="id" value="@route.Id" />
                                <button class="button button--compact button--danger-quiet" type="submit">Löschen</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Routes.Count == 0)
            {
                <tr><td colspan="5" class="empty-state">Noch keine Route angelegt.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
