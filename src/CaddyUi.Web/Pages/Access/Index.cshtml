@page
@model CaddyUi.Web.Pages.Access.IndexModel
@{
    ViewData["Title"] = T["Access groups"];
    var createGroupOpen = ViewContext.HttpContext.Request.Query.ContainsKey("create-group") ||
        ViewData.ModelState.Any(entry => entry.Key.StartsWith("NewGroup.", StringComparison.Ordinal) && entry.Value?.Errors.Count > 0);
    var createCredentialOpen = ViewContext.HttpContext.Request.Query.ContainsKey("create-credential") ||
        ViewData.ModelState.Any(entry => entry.Key.StartsWith("NewCredential.", StringComparison.Ordinal) && entry.Value?.Errors.Count > 0);
    var editGroupOpen = ViewContext.HttpContext.Request.Query.ContainsKey("editGroup") ||
        ViewData.ModelState.Any(entry => entry.Key.StartsWith("EditGroup.", StringComparison.Ordinal) && entry.Value?.Errors.Count > 0);
    var editCredentialOpen = ViewContext.HttpContext.Request.Query.ContainsKey("editCredential") ||
        ViewData.ModelState.Any(entry => entry.Key.StartsWith("EditCredential.", StringComparison.Ordinal) && entry.Value?.Errors.Count > 0);
}

<section class="page-heading page-heading--compact">
    <div>
        <p class="eyebrow">Access Portal</p>
        <h1>@T["Access groups"]</h1>
        <p class="page-description">@T["Groups protect individual routes. Passwords are stored only as hashes and existing passwords are never displayed."]</p>
    </div>
    <div class="page-actions">
        <a class="button button--quiet" asp-page="/Routing/Index">@T["Go to routes"]</a>
        <a class="button button--primary" href="?create-group=1" data-dialog-open="create-group-dialog">@T["Create group"]</a>
        <a class="button" href="?create-credential=1" data-dialog-open="create-credential-dialog">@T["Create credential"]</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice notice--ok" role="status">@Model.StatusMessage</div>
}
@if (TempData["Error"] is string operationError)
{
    <div class="notice notice--warning">@operationError</div>
}
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="notice notice--warning"><strong>@T["Access groups are currently unavailable"]</strong><span>@Model.LoadError</span><small>@T["Check that all PostgreSQL migrations have been applied."]</small></div>
}
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<article class="workspace-section">
    <header class="section-header"><div><h2>@T["Groups"]</h2><p>@T["{0} access groups", Model.Groups.Count]</p></div></header>
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>@T["Group"]</th><th>@T["Credentials"]</th><th>@T["Routes"]</th><th>@T["Status"]</th><th class="table-actions">@T["Actions"]</th></tr></thead>
            <tbody>
            @foreach (var group in Model.Groups)
            {
                var deleteBlocked = group.CredentialCount > 0 || group.RouteCount > 0;
                <tr class="@(group.Enabled ? string.Empty : "is-muted")">
                    <td><strong>@group.Name</strong><small>@group.Description</small></td>
                    <td>@group.CredentialCount</td>
                    <td>@group.RouteCount</td>
                    <td><span class="status-badge @(group.Enabled ? "status-badge--ok" : "status-badge--neutral")">@(group.Enabled ? T["Enabled"] : T["Disabled"])</span></td>
                    <td class="table-actions">
                        <div class="row-actions">
                            <a class="button button--compact button--quiet" asp-page="./Index" asp-route-editGroup="@group.Id">@T["Edit"]</a>
                            <form method="post" asp-page-handler="ToggleGroup">
                                <input type="hidden" name="id" value="@group.Id" />
                                <input type="hidden" name="enabled" value="@(!group.Enabled)" />
                                <button class="button button--compact button--quiet" type="submit">@(group.Enabled ? T["Disable"] : T["Enable"])</button>
                            </form>
                            <form method="post" asp-page-handler="DeleteGroup" data-confirm="@T["Delete this access group permanently?"]">
                                <input type="hidden" name="id" value="@group.Id" />
                                <button class="button button--compact button--danger-quiet" type="submit" disabled="@deleteBlocked" title="@(deleteBlocked ? T["Remove assigned routes and credentials before deleting this group."] : null)">@T["Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Groups.Count == 0 && string.IsNullOrWhiteSpace(Model.LoadError))
            {
                <tr><td colspan="5" class="empty-state">@T["No access group exists yet."]</td></tr>
            }
            </tbody>
        </table>
    </div>
</article>

<article class="workspace-section">
    <header class="section-header"><div><h2>@T["Portal credentials"]</h2><p>@T["User accounts for protected routes."]</p></div></header>
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>@T["User"]</th><th>@T["Group"]</th><th>@T["Created"]</th><th>@T["Status"]</th><th class="table-actions">@T["Actions"]</th></tr></thead>
            <tbody>
            @foreach (var credential in Model.Credentials)
            {
                var group = Model.Groups.FirstOrDefault(item => item.Id == credential.GroupId);
                <tr class="@(credential.Enabled ? string.Empty : "is-muted")">
                    <td><strong>@credential.Username</strong></td>
                    <td>@(group?.Name ?? T["Unknown"])</td>
                    <td><time datetime="@credential.CreatedAt.ToString("O")" data-local-time>@credential.CreatedAt.ToString("u")</time></td>
                    <td><span class="status-badge @(credential.Enabled ? "status-badge--ok" : "status-badge--neutral")">@(credential.Enabled ? T["Enabled"] : T["Disabled"])</span></td>
                    <td class="table-actions">
                        <div class="row-actions">
                            <a class="button button--compact button--quiet" asp-page="./Index" asp-route-editCredential="@credential.Id">@T["Edit"]</a>
                            <form method="post" asp-page-handler="ToggleCredential">
                                <input type="hidden" name="id" value="@credential.Id" />
                                <input type="hidden" name="enabled" value="@(!credential.Enabled)" />
                                <button class="button button--compact button--quiet" type="submit">@(credential.Enabled ? T["Disable"] : T["Enable"])</button>
                            </form>
                            <form method="post" asp-page-handler="DeleteCredential" data-confirm="@T["Delete this portal credential permanently?"]">
                                <input type="hidden" name="id" value="@credential.Id" />
                                <button class="button button--compact button--danger-quiet" type="submit">@T["Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Credentials.Count == 0 && string.IsNullOrWhiteSpace(Model.LoadError))
            {
                <tr><td colspan="5" class="empty-state">@T["No portal credential exists yet."]</td></tr>
            }
            </tbody>
        </table>
    </div>
</article>

<dialog id="create-group-dialog" class="dialog-surface dialog-surface--compact" data-dialog aria-labelledby="create-group-dialog-title" open="@(createGroupOpen ? "open" : null)">
    <div class="dialog-layout">
        <header class="dialog-header">
            <div><h2 id="create-group-dialog-title">@T["Create group"]</h2><p>@T["Use a clear name and an optional purpose."]</p></div>
            <a class="button button--compact button--quiet" asp-page="./Index" data-dialog-close>@T["Close"]</a>
        </header>
        <div class="dialog-body">
            <form id="create-group-form" method="post" asp-page-handler="CreateGroup" class="form-stack">
                <fieldset disabled="@(!string.IsNullOrWhiteSpace(Model.LoadError))">
                    <label class="field"><span class="field-label">@T["Name"]</span><input asp-for="NewGroup.Name" /><span asp-validation-for="NewGroup.Name" class="field-error"></span></label>
                    <label class="field"><span class="field-label">@T["Description"]</span><textarea asp-for="NewGroup.Description" rows="4"></textarea></label>
                </fieldset>
            </form>
        </div>
        <footer class="dialog-footer">
            <a class="button button--quiet" asp-page="./Index" data-dialog-close>@T["Cancel"]</a>
            <button class="button button--primary" type="submit" form="create-group-form" disabled="@(!string.IsNullOrWhiteSpace(Model.LoadError))">@T["Create group"]</button>
        </footer>
    </div>
</dialog>

<dialog id="edit-group-dialog" class="dialog-surface dialog-surface--compact" data-dialog aria-labelledby="edit-group-dialog-title" open="@(editGroupOpen ? "open" : null)">
    <div class="dialog-layout">
        <header class="dialog-header">
            <div><h2 id="edit-group-dialog-title">@T["Edit access group"]</h2><p>@T["Change the name or purpose without changing route assignments."]</p></div>
            <a class="button button--compact button--quiet" asp-page="./Index" data-dialog-close>@T["Close"]</a>
        </header>
        <div class="dialog-body">
            <form id="edit-group-form" method="post" asp-page-handler="UpdateGroup" class="form-stack">
                <input asp-for="EditGroup.Id" type="hidden" />
                <label class="field"><span class="field-label">@T["Name"]</span><input asp-for="EditGroup.Name" /><span asp-validation-for="EditGroup.Name" class="field-error"></span></label>
                <label class="field"><span class="field-label">@T["Description"]</span><textarea asp-for="EditGroup.Description" rows="4"></textarea></label>
            </form>
        </div>
        <footer class="dialog-footer">
            <a class="button button--quiet" asp-page="./Index" data-dialog-close>@T["Cancel"]</a>
            <button class="button button--primary" type="submit" form="edit-group-form">@T["Save"]</button>
        </footer>
    </div>
</dialog>

<dialog id="create-credential-dialog" class="dialog-surface dialog-surface--compact" data-dialog aria-labelledby="create-credential-dialog-title" open="@(createCredentialOpen ? "open" : null)">
    <div class="dialog-layout">
        <header class="dialog-header">
            <div><h2 id="create-credential-dialog-title">@T["Create credential"]</h2><p>@T["Use at least twelve characters. The password is not displayed again."]</p></div>
            <a class="button button--compact button--quiet" asp-page="./Index" data-dialog-close>@T["Close"]</a>
        </header>
        <div class="dialog-body">
            <form id="create-credential-form" method="post" asp-page-handler="CreateCredential" class="form-stack">
                <fieldset disabled="@(!string.IsNullOrWhiteSpace(Model.LoadError))">
                    <label class="field"><span class="field-label">@T["Group"]</span><select asp-for="NewCredential.GroupId"><option value="">@T["Select"]</option>@foreach (var group in Model.Groups.Where(item => item.Enabled)){<option value="@group.Id">@group.Name</option>}</select><span asp-validation-for="NewCredential.GroupId" class="field-error"></span></label>
                    <label class="field"><span class="field-label">@T["Username"]</span><input asp-for="NewCredential.Username" autocomplete="off" /><span asp-validation-for="NewCredential.Username" class="field-error"></span></label>
                    <label class="field"><span class="field-label">@T["Password"]</span><input asp-for="NewCredential.Password" type="password" autocomplete="new-password" /><span asp-validation-for="NewCredential.Password" class="field-error"></span></label>
                </fieldset>
            </form>
        </div>
        <footer class="dialog-footer">
            <a class="button button--quiet" asp-page="./Index" data-dialog-close>@T["Cancel"]</a>
            <button class="button button--primary" type="submit" form="create-credential-form" disabled="@(!string.IsNullOrWhiteSpace(Model.LoadError))">@T["Create credential"]</button>
        </footer>
    </div>
</dialog>

<dialog id="edit-credential-dialog" class="dialog-surface dialog-surface--compact" data-dialog aria-labelledby="edit-credential-dialog-title" open="@(editCredentialOpen ? "open" : null)">
    <div class="dialog-layout">
        <header class="dialog-header">
            <div><h2 id="edit-credential-dialog-title">@T["Edit portal credential"]</h2><p>@T["Leave the new password empty to keep the existing password."]</p></div>
            <a class="button button--compact button--quiet" asp-page="./Index" data-dialog-close>@T["Close"]</a>
        </header>
        <div class="dialog-body">
            <form id="edit-credential-form" method="post" asp-page-handler="UpdateCredential" class="form-stack">
                <input asp-for="EditCredential.Id" type="hidden" />
                <label class="field"><span class="field-label">@T["Username"]</span><input asp-for="EditCredential.Username" autocomplete="off" /><span asp-validation-for="EditCredential.Username" class="field-error"></span></label>
                <label class="field"><span class="field-label">@T["New password"]</span><input asp-for="EditCredential.NewPassword" type="password" autocomplete="new-password" /><span asp-validation-for="EditCredential.NewPassword" class="field-error"></span><small>@T["Use at least twelve characters when changing the password."]</small></label>
            </form>
        </div>
        <footer class="dialog-footer">
            <a class="button button--quiet" asp-page="./Index" data-dialog-close>@T["Cancel"]</a>
            <button class="button button--primary" type="submit" form="edit-credential-form">@T["Save"]</button>
        </footer>
    </div>
</dialog>
