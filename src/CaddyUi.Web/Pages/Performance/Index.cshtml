@page
@model CaddyUi.Web.Pages.Performance.IndexModel
@{
    ViewData["Title"] = T["Errors and performance"];
}
<section class="page-heading"><div><p class="eyebrow">@T["Quality"]</p><h1>@T["Errors and performance"]</h1><p class="page-description">@T["Latency percentiles, slowest normalized paths, and most common HTTP errors for the selected period."]</p></div></section>
<partial name="Shared/_AnalyticsFilters" model="Model" />
<section class="metric-grid metric-grid--dense">
<article class="metric-card"><span class="metric-label">@T["Requests"]</span><strong class="metric-value">@Model.Performance.Requests.ToString("N0")</strong></article>
<article class="metric-card"><span class="metric-label">@T["Errors"]</span><strong class="metric-value">@Model.Performance.Errors.ToString("N0")</strong></article>
<article class="metric-card"><span class="metric-label">@T["Average"]</span><strong class="metric-value">@AnalyticsPageModelBase.FormatDuration(Model.Performance.AverageDurationMilliseconds)</strong></article>
<article class="metric-card"><span class="metric-label">p50</span><strong class="metric-value">@AnalyticsPageModelBase.FormatDuration(Model.Performance.P50DurationMilliseconds)</strong></article>
<article class="metric-card"><span class="metric-label">p95</span><strong class="metric-value">@AnalyticsPageModelBase.FormatDuration(Model.Performance.P95DurationMilliseconds)</strong></article>
<article class="metric-card"><span class="metric-label">p99</span><strong class="metric-value">@AnalyticsPageModelBase.FormatDuration(Model.Performance.P99DurationMilliseconds)</strong></article>
<article class="metric-card"><span class="metric-label">@T["Maximum"]</span><strong class="metric-value">@AnalyticsPageModelBase.FormatDuration(Model.Performance.MaximumDurationMilliseconds)</strong></article>
</section>
<section class="analytics-columns analytics-columns--two">
<article class="panel"><header class="panel-header"><div><p class="eyebrow">@T["Latency"]</p><h2>@T["Slowest routes"]</h2></div></header><div class="panel-body table-wrap"><table class="data-table"><thead><tr><th>@T["Route"]</th><th>@T["Requests"]</th><th>@T["Average"]</th><th>@T["Maximum"]</th></tr></thead><tbody>
@foreach (var route in Model.Performance.SlowRoutes)
{
<tr><td><strong>@route.Host</strong><small><code>@route.Path</code></small></td><td>@route.RequestCount.ToString("N0")</td><td>@AnalyticsPageModelBase.FormatDuration(route.AverageDurationMilliseconds)</td><td>@AnalyticsPageModelBase.FormatDuration(route.MaximumDurationMilliseconds)</td></tr>
}
</tbody></table></div></article>
<article class="panel"><header class="panel-header"><div><p class="eyebrow">HTTP</p><h2>@T["Most common errors"]</h2></div></header><div class="panel-body table-wrap"><table class="data-table"><thead><tr><th>@T["Status"]</th><th>@T["Route"]</th><th>@T["Count"]</th></tr></thead><tbody>
@foreach (var error in Model.Performance.CommonErrors)
{
<tr><td><span class="status-code status-code--@((error.Status / 100).ToString())xx">@error.Status</span></td><td><strong>@error.Host</strong><small><code>@error.Path</code></small></td><td>@error.Count.ToString("N0")</td></tr>
}
</tbody></table></div></article>
</section>
