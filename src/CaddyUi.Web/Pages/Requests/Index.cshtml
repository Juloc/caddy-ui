@page
@model CaddyUi.Web.Pages.Requests.IndexModel
@{
    ViewData["Title"] = T["Requests"];
}
<section class="page-heading">
    <div><p class="eyebrow">@T["Raw events"]</p><h1>@T["Requests"]</h1><p class="page-description">@T["Every HTTP request processed by the server appears exactly once. Sensitive query and header values were redacted before storage."]</p></div>
    <div class="page-actions">
        <span class="status-badge status-badge--neutral">@T["{0} entries", Model.Requests.Count]</span>
        <a class="button button--quiet" asp-page="/LiveLog/Index">Live-Log</a>
        <a class="button button--quiet" asp-page="/Traffic/Index">@T["Traffic"]</a>
    </div>
</section>
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="notice notice--warning"><strong>@T["Requests are currently unavailable"]</strong><span>@Model.LoadError</span><small>@T["Check PostgreSQL migrations, the analytics worker, and the mounted Caddy logs."]</small></div>
}
<partial name="Shared/_AnalyticsFilters" model="Model" />
<section class="panel panel--wide">
    <div class="panel-body table-wrap">
        <table class="data-table request-table">
            <thead><tr><th>@T["Time"]</th><th>@T["Host / path"]</th><th>@T["Method"]</th><th>@T["Status"]</th><th>@T["Type"]</th><th>@T["Actor"]</th><th>@T["Duration"]</th><th>@T["Bytes"]</th><th>@T["Client"]</th></tr></thead>
            <tbody>
            @foreach (var request in Model.Requests)
            {
                <tr>
                    <td><time datetime="@request.OccurredAt.ToString("O")" data-local-time>@request.OccurredAt.ToString("u")</time></td>
                    <td><strong>@request.Host</strong><small><code>@request.Path</code></small></td>
                    <td><code>@request.Method</code></td>
                    <td><span class="status-code status-code--@((request.Status / 100).ToString())xx">@request.Status</span></td>
                    <td>@request.RequestType</td><td>@request.ActorType</td>
                    <td>@AnalyticsPageModelBase.FormatDuration(request.DurationMilliseconds)</td>
                    <td>@AnalyticsPageModelBase.FormatBytes(request.BytesSent)</td>
                    <td>@if (request.ClientId.Length > 0) { <a asp-page="/Security/Client" asp-route-id="@request.ClientId"><code>@request.ClientId[..8]</code></a> } else { <span>–</span> }<small>@request.RemoteAddress</small></td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Requests.Count == 0 && string.IsNullOrWhiteSpace(Model.LoadError)) { <p class="empty-state">@T["No requests match the filter."]</p> }
    </div>
</section>
