@page
@model CaddyUi.Web.Pages.Requests.IndexModel
@{
    ViewData["Title"] = "Requests";
}
<section class="page-heading"><div><p class="eyebrow">Rohereignisse</p><h1>Requests</h1><p class="page-description">Jeder vom Server verarbeitete HTTP-Request erscheint genau einmal. Empfindliche Query- und Headerwerte wurden bereits vor der Speicherung redigiert.</p></div><span class="status-badge status-badge--neutral">@Model.Requests.Count Einträge</span></section>
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="notice notice--warning"><strong>Requests sind momentan nicht verfügbar</strong><span>@Model.LoadError</span><small>Prüfe PostgreSQL-Migrationen sowie den Analytics-Worker und die eingebundenen Caddy-Logs.</small></div>
}
<partial name="Shared/_AnalyticsFilters" model="Model" />
<section class="panel panel--wide">
    <div class="panel-body table-wrap">
        <table class="data-table request-table">
            <thead><tr><th>Zeit</th><th>Host / Pfad</th><th>Methode</th><th>Status</th><th>Typ</th><th>Akteur</th><th>Laufzeit</th><th>Bytes</th><th>Client</th></tr></thead>
            <tbody>
            @foreach (var request in Model.Requests)
            {
                <tr>
                    <td>@request.OccurredAt.ToLocalTime().ToString("G")</td>
                    <td><strong>@request.Host</strong><small><code>@request.Path</code></small></td>
                    <td><code>@request.Method</code></td>
                    <td><span class="status-code status-code--@((request.Status / 100).ToString())xx">@request.Status</span></td>
                    <td>@request.RequestType</td><td>@request.ActorType</td>
                    <td>@AnalyticsPageModelBase.FormatDuration(request.DurationMilliseconds)</td>
                    <td>@AnalyticsPageModelBase.FormatBytes(request.BytesSent)</td>
                    <td>@if (request.ClientId.Length > 0) { <a asp-page="/Security/Client" asp-route-id="@request.ClientId"><code>@request.ClientId[..8]</code></a> } else { <span>–</span> }<small>@request.RemoteAddress</small></td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Requests.Count == 0 && string.IsNullOrWhiteSpace(Model.LoadError)) { <p class="empty-state">Keine Requests für den Filter.</p> }
    </div>
</section>
