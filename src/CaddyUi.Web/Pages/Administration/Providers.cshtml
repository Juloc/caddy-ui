@page
@using CaddyUi.Application.Dns
@model CaddyUi.Web.Pages.Administration.ProvidersModel
@{
    ViewData["Title"] = "DNS-Provider";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">DNS und Zertifikate</p>
        <h1>DNS-Provider</h1>
        <p class="page-description">Provider auswählen, passende Felder ausfüllen und anschließend mit einer zugeordneten Domain testen. Secret-Werte werden nicht gespeichert.</p>
    </div>
    <div class="page-actions">
        <span class="status-badge status-badge--neutral">@DnsProviderCatalog.All.Count Provider-Typen</span>
        <a class="button button--primary" asp-page="/Setup/Index">Geführte Einrichtung</a>
    </div>
</section>

@if (TempData["Message"] is string message)
{
    <div class="notice notice--success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="notice notice--warning">@error</div>
}
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="operations-grid operations-grid--sidebar">
    <article class="workbench">
        <header class="workbench-header">
            <div><p class="eyebrow">Konfiguriert</p><h2>@Model.Providers.Count Provider</h2></div>
        </header>
        <div class="workbench-body table-wrap">
            <table class="data-table">
                <thead><tr><th>Name</th><th>Typ</th><th>Direkt-API</th><th>Wildcard</th><th>Verbindung</th><th class="table-actions">Aktionen</th></tr></thead>
                <tbody>
                @foreach (var provider in Model.Providers)
                {
                    var domains = Model.Domains.Where(domain => domain.DnsProviderId == provider.Id && domain.Enabled).ToArray();
                    <tr>
                        <td><strong>@provider.Label</strong><small>@(provider.Enabled ? "aktiv" : "deaktiviert") · @domains.Length Domain(s)</small></td>
                        <td><code>@provider.ProviderType</code></td>
                        <td><span class="status-badge @(Model.SupportsDirectApi(provider.ProviderType) ? "status-badge--ok" : "status-badge--neutral")">@(Model.SupportsDirectApi(provider.ProviderType) ? "verfügbar" : "nur Verwaltung")</span></td>
                        <td><span class="status-badge @(Model.HasCaddyDnsModule(provider.ProviderType) ? "status-badge--ok" : "status-badge--warning")">@(Model.HasCaddyDnsModule(provider.ProviderType) ? "Caddy-Modul vorhanden" : "Caddy-Modul fehlt")</span></td>
                        <td>
                            <span class="status-badge @(provider.LastTestStatus == "ok" ? "status-badge--ok" : provider.LastTestStatus == "failed" ? "status-badge--danger" : "status-badge--neutral")">@(provider.LastTestStatus == "ok" ? "getestet" : provider.LastTestStatus == "failed" ? "Test fehlgeschlagen" : "nicht getestet")</span>
                            @if (!string.IsNullOrWhiteSpace(provider.LastTestError))
                            {
                                <small>@provider.LastTestError</small>
                            }
                        </td>
                        <td class="table-actions">
                            @if (domains.Length > 0 && Model.SupportsDirectApi(provider.ProviderType))
                            {
                                <form method="post" asp-page-handler="Test" class="inline-control">
                                    <input type="hidden" name="providerId" value="@provider.Id" />
                                    <select name="domainId" aria-label="Testdomain">
                                        @foreach (var domain in domains)
                                        {
                                            <option value="@domain.Id">@domain.Name</option>
                                        }
                                    </select>
                                    <button class="button button--compact button--primary" type="submit" disabled="@(!provider.Enabled)">Testen</button>
                                </form>
                            }
                            <form method="post" asp-page-handler="Toggle">
                                <input type="hidden" name="providerId" value="@provider.Id" />
                                <input type="hidden" name="enabled" value="@(!provider.Enabled)" />
                                <button class="button button--compact button--quiet" type="submit">@(provider.Enabled ? "Deaktivieren" : "Aktivieren")</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Providers.Count == 0)
                {
                    <tr><td colspan="6" class="empty-state">Noch kein DNS-Provider konfiguriert.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </article>

    <aside class="workbench">
        <header class="workbench-header">
            <div><p class="eyebrow">Neu</p><h2>Provider hinzufügen</h2></div>
        </header>
        <div class="workbench-body">
            <form method="post" asp-page-handler="Create" class="form-stack" data-provider-form>
                <label class="field">
                    <span class="field-label">Provider</span>
                    <select asp-for="Input.ProviderType" data-provider-type>
                        @foreach (var definition in DnsProviderCatalog.All)
                        {
                            <option value="@definition.Type">@definition.DisplayName</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span class="field-label">Anzeigename</span>
                    <input asp-for="Input.Label" placeholder="DNS Produktion" autocomplete="off" />
                    <small>Interner Name, zum Beispiel „Netcup Produktion“.</small>
                </label>

                @foreach (var definition in DnsProviderCatalog.All)
                {
                    <div class="provider-field-panel" data-provider-fields="@definition.Type">
                        <div class="provider-field-heading">
                            <div><strong>@definition.DisplayName</strong><small>@definition.DocumentationHint</small></div>
                        </div>
                        <div class="form-stack">
                            @foreach (var field in definition.Settings)
                            {
                                var fieldName = ProvidersModel.FieldName(definition.Type, field.Key);
                                <label class="field">
                                    <span class="field-label">@field.Label @(field.Required ? "*" : "")</span>
                                    <input name="Input.Settings[@fieldName]" value="@Model.Input.Settings.GetValueOrDefault(fieldName, field.DefaultValue ?? string.Empty)" autocomplete="off" />
                                    <small>@(field.HelpText ?? (field.DefaultValue is null ? "Nicht geheime Provider-Einstellung." : $"Standardwert: {field.DefaultValue}"))</small>
                                </label>
                            }
                            @foreach (var field in definition.Secrets)
                            {
                                var fieldName = ProvidersModel.FieldName(definition.Type, field.Key);
                                <label class="field">
                                    <span class="field-label">@field.Label *</span>
                                    <input name="Input.SecretReferences[@fieldName]" value="@Model.Input.SecretReferences.GetValueOrDefault(fieldName, string.Empty)" placeholder="UMGEBUNGSVARIABLE" autocomplete="off" spellcheck="false" />
                                    <small>@field.HelpText</small>
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="safe-apply-note">
                    <strong>Keine Zugangsdaten im Klartext</strong>
                    <span>Trage nur Namen von Umgebungsvariablen oder <code>secret://</code>-Referenzen ein.</span>
                </div>
                <button class="button button--primary" type="submit">Provider sicher anlegen</button>
            </form>
        </div>
    </aside>
</section>

<section class="workbench operations-section">
    <header class="workbench-header"><div><p class="eyebrow">Katalog</p><h2>Unterstützte Verträge</h2></div></header>
    <div class="workbench-body table-wrap">
        <table class="data-table">
            <thead><tr><th>Provider</th><th>Funktionen</th><th>Benötigte Angaben</th><th>Secrets</th></tr></thead>
            <tbody>
            @foreach (var definition in DnsProviderCatalog.All)
            {
                <tr>
                    <td><strong>@definition.DisplayName</strong><small>@definition.DocumentationHint</small></td>
                    <td>@definition.Capabilities</td>
                    <td>@(definition.Settings.Count == 0 ? "Keine" : string.Join(", ", definition.Settings.Select(field => field.Label)))</td>
                    <td>@(definition.Secrets.Count == 0 ? "Keine" : string.Join(", ", definition.Secrets.Select(field => field.Label)))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<script>
(() => {
    const form = document.querySelector('[data-provider-form]');
    if (!form) return;
    const selector = form.querySelector('[data-provider-type]');
    const update = () => {
        form.querySelectorAll('[data-provider-fields]').forEach(panel => {
            panel.hidden = panel.dataset.providerFields !== selector.value;
        });
    };
    selector.addEventListener('change', update);
    update();
})();
</script>
