@page
@using CaddyUi.Application.Dns
@model CaddyUi.Web.Pages.Administration.ProvidersModel
@{
    ViewData["Title"] = T["DNS providers"];
}

<section class="page-heading">
    <div>
        <p class="eyebrow">@T["DNS and certificates"]</p>
        <h1>@T["DNS providers"]</h1>
        <p class="page-description">@T["Select a provider and enter only the required values. Credentials are encrypted and are never displayed again."]</p>
    </div>
    <div class="page-actions">
        <span class="status-badge status-badge--neutral">@T["{0} provider types", DnsProviderCatalog.All.Count]</span>
        <a class="button button--primary" asp-page="/Setup/Index">@T["Set up domain with provider"]</a>
    </div>
</section>

@if (TempData["Message"] is string message)
{
    <div class="notice notice--success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="notice notice--warning" role="alert">@error</div>
}
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="notice notice--warning" role="alert"><strong>@T["Loading failed"]</strong><span>@Model.LoadError</span></div>
}
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

<section class="operations-grid operations-grid--sidebar">
    <article class="workbench">
        <header class="workbench-header">
            <div><p class="eyebrow">@T["Configured"]</p><h2>@T["{0} providers", Model.Providers.Count]</h2></div>
        </header>
        <div class="workbench-body table-wrap provider-table-wrap">
            <table class="data-table provider-table">
                <thead><tr><th>@T["Name"]</th><th>@T["Type"]</th><th>@T["DNS API"]</th><th>@T["Wildcard"]</th><th>@T["Connection"]</th><th class="provider-actions-heading">@T["Actions"]</th></tr></thead>
                <tbody>
                @foreach (var provider in Model.Providers)
                {
                    var domains = Model.Domains.Where(domain => domain.DnsProviderId == provider.Id && domain.Enabled).ToArray();
                    <tr>
                        <td data-label="@T["Name"]"><strong>@provider.Label</strong><small>@(provider.Enabled ? T["enabled"] : T["disabled"]) · @T["{0} domains", domains.Length]</small></td>
                        <td data-label="@T["Type"]"><code>@provider.ProviderType</code></td>
                        <td data-label="@T["DNS API"]"><span class="status-badge @(Model.SupportsDirectApi(provider.ProviderType) ? "status-badge--ok" : "status-badge--neutral")">@(Model.SupportsDirectApi(provider.ProviderType) ? T["available"] : T["certificates only"])</span></td>
                        <td data-label="@T["Wildcard"]"><span class="status-badge @(Model.HasCaddyDnsModule(provider.ProviderType) ? "status-badge--ok" : "status-badge--warning")">@(Model.HasCaddyDnsModule(provider.ProviderType) ? T["module installed"] : T["module missing"])</span></td>
                        <td data-label="@T["Connection"]">
                            <span class="status-badge @(provider.LastTestStatus == "ok" ? "status-badge--ok" : provider.LastTestStatus == "failed" ? "status-badge--danger" : "status-badge--neutral")">@(provider.LastTestStatus == "ok" ? T["tested"] : provider.LastTestStatus == "failed" ? T["test failed"] : T["not tested"])</span>
                            @if (!string.IsNullOrWhiteSpace(provider.LastTestError))
                            {
                                <small>@provider.LastTestError</small>
                            }
                        </td>
                        <td class="provider-actions-cell" data-label="@T["Actions"]">
                            <div class="provider-actions">
                                @if (domains.Length > 0 && Model.CanListRecords(provider.ProviderType))
                                {
                                    <a class="button button--compact button--quiet" asp-page="/Administration/ProviderDns" asp-route-providerId="@provider.Id">@T["DNS"]</a>
                                }
                                @if (domains.Length > 0 && Model.SupportsDirectApi(provider.ProviderType))
                                {
                                    <form method="post" asp-page-handler="Test" class="provider-test-form">
                                        <input type="hidden" name="providerId" value="@provider.Id" />
                                        <select name="domainId" aria-label="@T["Test domain"]">
                                            @foreach (var domain in domains)
                                            {
                                                <option value="@domain.Id">@domain.Name</option>
                                            }
                                        </select>
                                        <button class="button button--compact button--primary" type="submit" disabled="@(!provider.Enabled)">@T["Test"]</button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Toggle" class="provider-toggle-form">
                                    <input type="hidden" name="providerId" value="@provider.Id" />
                                    <input type="hidden" name="enabled" value="@(!provider.Enabled)" />
                                    <button class="button button--compact button--quiet" type="submit">@(provider.Enabled ? T["Disable"] : T["Enable"])</button>
                                </form>
                                @if (ProvidersModel.SupportsManagedDnsChallengeTiming(provider.ProviderType))
                                {
                                    <details class="provider-dns-timing">
                                        <summary class="button button--compact button--quiet">@T["DNS-01 timing"]</summary>
                                        <form method="post" asp-page-handler="DnsChallengeTiming" class="form-stack">
                                            <input type="hidden" name="providerId" value="@provider.Id" />
                                            <label class="field">
                                                <span class="field-label">@T["Propagation delay"]</span>
                                                <input name="propagationDelay" value="@ProvidersModel.ProviderSetting(provider, DnsChallengeTiming.PropagationDelayKey)" placeholder="600s" autocomplete="off" />
                                                <small>@T["Wait before the first DNS check. Empty uses Caddy's default of 0 seconds."]</small>
                                            </label>
                                            <label class="field">
                                                <span class="field-label">@T["Propagation timeout"]</span>
                                                <input name="propagationTimeout" value="@ProvidersModel.ProviderSetting(provider, DnsChallengeTiming.PropagationTimeoutKey)" placeholder="900s" autocomplete="off" />
                                                <small>@T["Maximum time to wait for the TXT record. Empty uses Caddy's default of 2 minutes."]</small>
                                            </label>
                                            <small>@T["Use seconds or durations such as 600s, 15m, or 1h."]</small>
                                            <button class="button button--compact button--primary" type="submit">@T["Save timing"]</button>
                                        </form>
                                    </details>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Providers.Count == 0)
                {
                    <tr class="provider-table-empty"><td colspan="6" class="empty-state">@T["No DNS provider has been configured."]</td></tr>
                }
                </tbody>
            </table>
        </div>
    </article>

    <aside class="workbench">
        <header class="workbench-header">
            <div><p class="eyebrow">@T["New"]</p><h2>@T["Add provider"]</h2></div>
        </header>
        <div class="workbench-body">
            <form method="post" asp-page-handler="Create" class="form-stack" data-provider-form>
                <label class="field">
                    <span class="field-label">@T["Provider"]</span>
                    <select asp-for="Input.ProviderType" data-provider-type>
                        @foreach (var definition in DnsProviderCatalog.All)
                        {
                            <option value="@definition.Type">@definition.DisplayName</option>
                        }
                    </select>
                    <small>@T["Only fields required by the selected provider are shown."]</small>
                </label>
                <label class="field">
                    <span class="field-label">@T["Display name"]</span>
                    <input asp-for="Input.Label" placeholder="Netcup Production" autocomplete="off" />
                    <small>@T["Internal name used to identify this configuration."]</small>
                </label>

                @foreach (var definition in DnsProviderCatalog.All)
                {
                    <div class="provider-field-panel" data-provider-fields="@definition.Type">
                        <div class="provider-field-heading">
                            <div><strong>@definition.DisplayName</strong><small>@T[definition.DocumentationHint]</small></div>
                        </div>
                        <div class="form-stack">
                            @foreach (var field in definition.Settings)
                            {
                                var fieldName = ProvidersModel.FieldName(definition.Type, field.Key);
                                <label class="field">
                                    <span class="field-label">@T[field.Label] @(field.Required ? "*" : "")</span>
                                    <input name="Input.Settings[@fieldName]" value="@Model.Input.Settings.GetValueOrDefault(fieldName, field.DefaultValue ?? string.Empty)" autocomplete="off" />
                                    <small>@T[field.HelpText ?? string.Empty]</small>
                                </label>
                            }
                            @foreach (var field in definition.Secrets)
                            {
                                var fieldName = ProvidersModel.FieldName(definition.Type, field.Key);
                                <label class="field">
                                    <span class="field-label">@T[field.Label] *</span>
                                    <input type="password" name="Input.Secrets[@fieldName]" placeholder="@T["Enter credentials"]" autocomplete="new-password" spellcheck="false" />
                                    <small>@T["Stored encrypted with ASP.NET Data Protection. Advanced users can enter secret://env/NAME or secret://file/PATH instead."]</small>
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="safe-apply-note">
                    <strong>@T["Encrypted storage"]</strong>
                    <span>@T["Secret values are never displayed in logs, tables, diagnostic packages, or later forms."]</span>
                </div>
                <button class="button button--primary" type="submit">@T["Save provider"]</button>
            </form>
        </div>
    </aside>
</section>

<section class="workbench operations-section">
    <header class="workbench-header"><div><p class="eyebrow">@T["Support"]</p><h2>@T["Provider capabilities"]</h2></div></header>
    <div class="workbench-body table-wrap">
        <table class="data-table">
            <thead><tr><th>@T["Provider"]</th><th>@T["Capabilities"]</th><th>@T["Required settings"]</th><th>@T["Credentials"]</th></tr></thead>
            <tbody>
            @foreach (var definition in DnsProviderCatalog.All)
            {
                <tr>
                    <td><strong>@definition.DisplayName</strong><small>@T[definition.DocumentationHint]</small></td>
                    <td>@definition.Capabilities</td>
                    <td>@(definition.Settings.Count == 0 ? T["None"] : string.Join(", ", definition.Settings.Select(field => T[field.Label].Value)))</td>
                    <td>@(definition.Secrets.Count == 0 ? T["None"] : string.Join(", ", definition.Secrets.Select(field => T[field.Label].Value)))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<script>
(() => {
    const form = document.querySelector('[data-provider-form]');
    if (!form) return;
    const selector = form.querySelector('[data-provider-type]');
    const update = () => {
        form.querySelectorAll('[data-provider-fields]').forEach(panel => {
            panel.hidden = panel.dataset.providerFields !== selector.value;
            panel.querySelectorAll('input, select, textarea').forEach(control => {
                control.disabled = panel.hidden;
            });
        });
    };
    selector.addEventListener('change', update);
    update();
})();
</script>