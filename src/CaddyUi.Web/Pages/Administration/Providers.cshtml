@page
@using CaddyUi.Application.Dns
@model CaddyUi.Web.Pages.Administration.ProvidersModel
@{
    ViewData["Title"] = "DNS-Provider";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">DNS und Zertifikate</p>
        <h1>Provider</h1>
        <p class="page-description">Provider werden zentral angelegt und anschließend Domains zugeordnet. API-Secrets werden nur als Umgebungsvariablen- oder Secret-Referenzen gespeichert.</p>
    </div>
    <span class="status-badge status-badge--ok">@DnsProviderCatalog.All.Count Provider-Typen</span>
</section>

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="workspace-grid">
    <article class="panel panel--wide">
        <header class="panel-header">
            <div>
                <p class="eyebrow">Konfiguriert</p>
                <h2>@Model.Providers.Count Provider</h2>
            </div>
        </header>
        <div class="panel-body table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Typ</th>
                        <th>Status</th>
                        <th>API-Test</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var provider in Model.Providers)
                    {
                        <tr>
                            <td><strong>@provider.Label</strong></td>
                            <td><code>@provider.ProviderType</code></td>
                            <td>@(provider.Enabled ? "Aktiv" : "Deaktiviert")</td>
                            <td>
                                <span class="status-badge @(provider.LastTestStatus == "ok" ? "status-badge--ok" : "status-badge--neutral")">
                                    @provider.LastTestStatus
                                </span>
                                @if (!string.IsNullOrWhiteSpace(provider.LastTestError))
                                {
                                    <small>@provider.LastTestError</small>
                                }
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Toggle">
                                    <input type="hidden" name="providerId" value="@provider.Id" />
                                    <input type="hidden" name="enabled" value="@(!provider.Enabled)" />
                                    <button class="button button--quiet" type="submit">@(provider.Enabled ? "Deaktivieren" : "Aktivieren")</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Providers.Count == 0)
                    {
                        <tr><td colspan="5">Noch kein DNS-Provider konfiguriert.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </article>

    <aside class="panel">
        <header class="panel-header">
            <div>
                <p class="eyebrow">Neu</p>
                <h2>Provider hinzufügen</h2>
            </div>
        </header>
        <div class="panel-body">
            <form method="post" asp-page-handler="Create" class="form-stack">
                <label>
                    <span>Provider-Typ</span>
                    <select asp-for="Input.ProviderType">
                        @foreach (var definition in DnsProviderCatalog.All)
                        {
                            <option value="@definition.Type">@definition.DisplayName</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Anzeigename</span>
                    <input asp-for="Input.Label" placeholder="Netcup Produktion" />
                </label>
                <label>
                    <span>Provider-Einstellungen als JSON</span>
                    <textarea asp-for="Input.ConfigJson" rows="6"></textarea>
                    <small>Nur nicht geheime Werte wie Region, Projekt, Kundennummer oder API-Endpunkt.</small>
                </label>
                <label>
                    <span>Secret-Referenzen als JSON</span>
                    <textarea asp-for="Input.SecretReferencesJson" rows="6"></textarea>
                    <small>Beispiel: <code>{"api_token":"CLOUDFLARE_API_TOKEN"}</code>. Keine Tokenwerte eintragen.</small>
                </label>
                <button class="button button--primary" type="submit">Provider anlegen</button>
            </form>
        </div>
    </aside>
</section>

<section class="panel">
    <header class="panel-header">
        <div>
            <p class="eyebrow">Katalog</p>
            <h2>Unterstützte API-Verträge</h2>
        </div>
    </header>
    <div class="panel-body provider-grid">
        @foreach (var definition in DnsProviderCatalog.All)
        {
            <article class="provider-card">
                <div>
                    <strong>@definition.DisplayName</strong>
                    <code>@definition.Type</code>
                </div>
                <p>@definition.DocumentationHint</p>
                <small>Funktionen: @definition.Capabilities</small>
                @if (definition.Settings.Count > 0)
                {
                    <small>Einstellungen: @string.Join(", ", definition.Settings.Select(field => field.Key))</small>
                }
                @if (definition.Secrets.Count > 0)
                {
                    <small>Secrets: @string.Join(", ", definition.Secrets.Select(field => field.Key))</small>
                }
            </article>
        }
    </div>
</section>
