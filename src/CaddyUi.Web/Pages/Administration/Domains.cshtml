@page
@using CaddyUi.Domain.Certificates
@model CaddyUi.Web.Pages.Administration.DomainsModel
@{
    ViewData["Title"] = "Domains";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Routing-Struktur</p>
        <h1>Domains</h1>
        <p class="page-description">Routen werden einer Domain zugeordnet. Mehrere Domains sind unabhängig konfigurierbar. Für neue Domains und Unterrouten ist das Wildcard-Zertifikat der Standard.</p>
    </div>
    <span class="status-badge status-badge--ok">Wildcard standardmäßig</span>
</section>

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="workspace-grid">
    <article class="panel panel--wide">
        <header class="panel-header">
            <div>
                <p class="eyebrow">Verwaltet</p>
                <h2>@Model.Domains.Count Domains</h2>
            </div>
        </header>
        <div class="panel-body table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Domain</th>
                        <th>DNS-Provider</th>
                        <th>Zertifikat</th>
                        <th>Routen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var domain in Model.Domains)
                    {
                        <tr>
                            <td>
                                <strong>@domain.DisplayName</strong>
                                <small>@domain.Name</small>
                                @if (domain.IsDefault)
                                {
                                    <span class="status-badge status-badge--ok">Standard</span>
                                }
                            </td>
                            <td>@(domain.DnsProviderLabel ?? "Nicht zugeordnet")</td>
                            <td><code>@domain.DefaultCertificateMode</code></td>
                            <td>@domain.RouteCount</td>
                            <td>
                                @if (!domain.IsDefault)
                                {
                                    <form method="post" asp-page-handler="Default">
                                        <input type="hidden" name="domainId" value="@domain.Id" />
                                        <button class="button button--quiet" type="submit">Als Standard</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Domains.Count == 0)
                    {
                        <tr><td colspan="5">Noch keine Domain angelegt.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </article>

    <aside class="panel">
        <header class="panel-header">
            <div>
                <p class="eyebrow">Neu</p>
                <h2>Domain hinzufügen</h2>
            </div>
        </header>
        <div class="panel-body">
            <form method="post" asp-page-handler="Create" class="form-stack">
                <label>
                    <span>Domain</span>
                    <input asp-for="Input.Name" placeholder="example.com" />
                </label>
                <label>
                    <span>Anzeigename</span>
                    <input asp-for="Input.DisplayName" placeholder="Example" />
                </label>
                <label>
                    <span>DNS-Provider</span>
                    <select asp-for="Input.DnsProviderId">
                        <option value="">Kein Provider</option>
                        @foreach (var provider in Model.Providers)
                        {
                            <option value="@provider.Id">@provider.Label (@provider.ProviderType)</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Standard-Zertifikat</span>
                    <select asp-for="Input.DefaultCertificateMode">
                        <option value="@CertificateMode.Wildcard">Wildcard (Standard)</option>
                        <option value="@CertificateMode.Individual">Einzelzertifikat</option>
                    </select>
                    <small><code>*.example.com</code> deckt genau eine Subdomain-Ebene ab. Tiefere Namen benötigen eine weitere Domain oder ein explizites Zertifikat.</small>
                </label>
                <label class="check">
                    <input asp-for="Input.MakeDefault" />
                    <span>Als Standarddomain verwenden</span>
                </label>
                <button class="button button--primary" type="submit">Domain anlegen</button>
            </form>
        </div>
    </aside>
</section>
