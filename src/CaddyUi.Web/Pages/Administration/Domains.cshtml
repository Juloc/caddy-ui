@page
@model CaddyUi.Web.Pages.Administration.DomainsModel
@{
    ViewData["Title"] = "Domains";
}

<section class="page-heading" data-certificate-auto-refresh="@(Model.HasActiveCertificateWork ? "true" : "false")">
    <div>
        <p class="eyebrow">DNS und Zertifikate</p>
        <h1>Domains</h1>
        <p class="page-description">Versuche, einzelne ACME-Schritte, DNS-Wartezeiten und Wiederholungen werden aus aktivem Stand, Zertifikatsspeicher und Caddy-Logs zusammengeführt.</p>
        <small class="certificate-time-zone">Zeitangaben: <strong data-local-time-zone>Browser-Zeitzone wird ermittelt</strong>. UTC bleibt als Tooltip erhalten.</small>
    </div>
    <div class="page-actions">
        @if (Model.HasActiveCertificateWork)
        {
            <span class="status-badge status-badge--warning">Automatische Aktualisierung · 15 s</span>
        }
        <a class="button button--quiet" asp-page="/Administration/Domains">Status aktualisieren</a>
        <a class="button button--primary" asp-page="/Setup/Index">Geführte Einrichtung</a>
    </div>
</section>

@if (TempData["Message"] is string message)
{
    <div class="notice notice--success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="notice notice--warning"><strong>Aktion fehlgeschlagen</strong><span>@error</span></div>
}
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<section class="operations-grid operations-grid--sidebar">
    <article class="workbench">
        <header class="workbench-header">
            <div><p class="eyebrow">Verwaltet</p><h2>@Model.Domains.Count Domains</h2></div>
            <a class="button button--compact button--quiet" asp-page="/Routing/Preview">Caddy-Vorschau</a>
        </header>
        <div class="workbench-body table-wrap domain-table-wrap">
            <table class="data-table domain-status-table">
                <thead>
                    <tr><th>Domain</th><th>DNS-Provider</th><th>Zertifikate</th><th>Routen</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var domain in Model.Domains)
                {
                    Model.CertificateStatuses.TryGetValue(domain.Id, out var certificateStatus);
                    Model.DnsChallengeTimings.TryGetValue(domain.Id, out var dnsTiming);
                    <tr>
                        <td data-label="Domain">
                            <strong>@domain.DisplayName</strong>
                            <small>@domain.Name</small>
                            @if (domain.IsDefault)
                            {
                                <span class="status-badge status-badge--ok">Standard</span>
                            }
                        </td>
                        <td data-label="DNS-Provider">
                            <strong>@(domain.DnsProviderLabel ?? "Nicht zugeordnet")</strong>
                            @if (domain.DnsProviderId is null)
                            {
                                <small>Für Wildcard erforderlich.</small>
                            }
                        </td>
                        <td data-label="Zertifikate">
                            <div class="certificate-status-list">
                                @if (certificateStatus is null)
                                {
                                    <span class="status-badge status-badge--neutral">Status nicht verfügbar</span>
                                }
                                else
                                {
                                    @foreach (var certificate in certificateStatus.Certificates)
                                    {
                                        var lifecycle = certificate.Lifecycle;
                                        var timing = certificate.Kind == "wildcard" ? dnsTiming : null;
                                        var attempts = DomainsModel.GroupAttempts(lifecycle);
                                        var estimatedCheckAt = DomainsModel.EstimatedDnsCheckAt(lifecycle, timing);
                                        var estimatedDeadlineAt = DomainsModel.EstimatedDnsDeadlineAt(lifecycle, timing);
                                        <article class="certificate-status-item" id="certificate-@domain.Id-@certificate.Kind">
                                            <div class="certificate-status-heading">
                                                <div>
                                                    <code>@certificate.Name</code>
                                                    <small>@certificate.Detail</small>
                                                </div>
                                                <span class="status-badge @DomainsModel.StatusClass(certificate.State)">@certificate.Label</span>
                                            </div>

                                            <div class="certificate-current-operation">
                                                <div class="certificate-current-operation-heading">
                                                    <div>
                                                        <span class="eyebrow">Aktueller Schritt</span>
                                                        <strong>@DomainsModel.CurrentAction(lifecycle)</strong>
                                                    </div>
                                                    <span class="status-badge @DomainsModel.StatusClass(certificate.State)">@lifecycle.Label</span>
                                                </div>
                                                <p>@DomainsModel.CurrentActionDetail(lifecycle, timing)</p>

                                                @if (certificate.Kind == "wildcard")
                                                {
                                                    <ol class="certificate-step-flow" aria-label="DNS-01-Ablauf">
                                                        <li class="@DomainsModel.StepClass(1, lifecycle)"><span>1</span><div><strong>ACME starten</strong><small>Konto, Namen und DNS-Provider laden</small></div></li>
                                                        <li class="@DomainsModel.StepClass(2, lifecycle)"><span>2</span><div><strong>TXT schreiben</strong><small><code>@lifecycle.DnsChallengeName</code></small></div></li>
                                                        <li class="@DomainsModel.StepClass(3, lifecycle)"><span>3</span><div><strong>DNS prüfen</strong><small>Delay @DomainsModel.FormatDuration(timing?.PropagationDelaySeconds), Timeout @DomainsModel.FormatDuration(timing?.PropagationTimeoutSeconds ?? lifecycle.PropagationTimeoutSeconds)</small></div></li>
                                                        <li class="@DomainsModel.StepClass(4, lifecycle)"><span>4</span><div><strong>Ausstellen und speichern</strong><small>ACME validiert und Caddy übernimmt das Zertifikat</small></div></li>
                                                    </ol>
                                                }
                                            </div>

                                            <details class="certificate-lifecycle" open="@(certificate.State is "renewal-failed" or "acquisition-failed" or "expired" or "retry-scheduled")">
                                                <summary>
                                                    <span>Diagnose und @attempts.Count Versuch(e)</span>
                                                    <span>Details anzeigen</span>
                                                </summary>
                                                <div class="certificate-lifecycle-body">
                                                    <dl class="certificate-lifecycle-grid">
                                                        <div><dt>Aktiver Caddy-Stand</dt><dd>@(lifecycle.Applied ? "Ja" : "Nein")</dd></div>
                                                        <div><dt>Erfasst</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(lifecycle.ObservedAt)">@DomainsModel.FormatUtc(lifecycle.ObservedAt)</time></dd></div>
                                                        <div><dt>Gültig ab</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(certificate.NotBefore)">@DomainsModel.FormatUtc(certificate.NotBefore)</time></dd></div>
                                                        <div><dt>Gültig bis</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(certificate.ExpiresAt)">@DomainsModel.FormatUtc(certificate.ExpiresAt)</time></dd></div>
                                                        <div><dt>Erneuerungsfenster</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(certificate.RenewalWindowStartsAt)">@DomainsModel.FormatUtc(certificate.RenewalWindowStartsAt)</time></dd></div>
                                                        <div><dt>Letzter Versuch</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(lifecycle.LastAttemptAt)">@DomainsModel.FormatUtc(lifecycle.LastAttemptAt)</time></dd></div>
                                                        <div><dt>Letzter Erfolg</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(lifecycle.LastSuccessAt)">@DomainsModel.FormatUtc(lifecycle.LastSuccessAt)</time></dd></div>
                                                        <div><dt>Nächster Versuch</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(lifecycle.NextAttemptAt)">@DomainsModel.FormatUtc(lifecycle.NextAttemptAt)</time></dd></div>
                                                        <div><dt>Versuche im Log</dt><dd>@lifecycle.AttemptCount</dd></div>
                                                        <div><dt>Fehler in Folge</dt><dd>@lifecycle.ConsecutiveFailures</dd></div>
                                                        @if (!string.IsNullOrWhiteSpace(lifecycle.ProviderType))
                                                        {
                                                            <div><dt>DNS-Provider</dt><dd>@lifecycle.ProviderType</dd></div>
                                                            <div><dt>Provider-Test</dt><dd>@DomainsModel.ProviderTestLabel(lifecycle.ProviderTestStatus)</dd></div>
                                                            <div><dt>Zuletzt getestet</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(lifecycle.ProviderLastTestedAt)">@DomainsModel.FormatUtc(lifecycle.ProviderLastTestedAt)</time></dd></div>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(lifecycle.DnsChallengeName))
                                                        {
                                                            <div><dt>DNS-01 TXT-Name</dt><dd><code>@lifecycle.DnsChallengeName</code></dd></div>
                                                            <div><dt>DNS-TTL</dt><dd>@DomainsModel.FormatDuration(lifecycle.DnsTtlSeconds)</dd></div>
                                                            <div><dt>Propagation-Delay</dt><dd>@DomainsModel.FormatDuration(timing?.PropagationDelaySeconds)</dd></div>
                                                            <div><dt>Propagation-Timeout</dt><dd>@DomainsModel.FormatDuration(timing?.PropagationTimeoutSeconds ?? lifecycle.PropagationTimeoutSeconds)</dd></div>
                                                            <div><dt>Erste DNS-Prüfung, geschätzt</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(estimatedCheckAt)">@DomainsModel.FormatUtc(estimatedCheckAt)</time></dd></div>
                                                            <div><dt>DNS-Prüfende, geschätzt</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(estimatedDeadlineAt)">@DomainsModel.FormatUtc(estimatedDeadlineAt)</time></dd></div>
                                                        }
                                                    </dl>

                                                    @if (!string.IsNullOrWhiteSpace(lifecycle.LastError))
                                                    {
                                                        <div class="certificate-lifecycle-error">
                                                            <strong>Letzter erkannter Fehler</strong>
                                                            <p>@lifecycle.LastError</p>
                                                        </div>
                                                    }

                                                    @if (attempts.Count > 0)
                                                    {
                                                        <section class="certificate-attempts">
                                                            <h3>Versuche einzeln aufgeschlüsselt</h3>
                                                            <div class="certificate-attempt-groups">
                                                                @foreach (var attempt in attempts)
                                                                {
                                                                    <article class="certificate-attempt-group">
                                                                        <header>
                                                                            <div><strong>Versuch @attempt.Number</strong><small>@attempt.Label</small></div>
                                                                            <span class="status-badge @DomainsModel.StatusClass(attempt.State)">@attempt.State</span>
                                                                        </header>
                                                                        <dl class="certificate-attempt-meta">
                                                                            <div><dt>Beginn</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(attempt.StartedAt)">@DomainsModel.FormatUtc(attempt.StartedAt)</time></dd></div>
                                                                            <div><dt>Ende</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(attempt.FinishedAt)">@DomainsModel.FormatUtc(attempt.FinishedAt)</time></dd></div>
                                                                            <div><dt>Wiederholung</dt><dd><time data-local-time datetime="@DomainsModel.FormatIso(attempt.NextAttemptAt)">@DomainsModel.FormatUtc(attempt.NextAttemptAt)</time></dd></div>
                                                                        </dl>
                                                                        <ol>
                                                                            @foreach (var item in attempt.Events)
                                                                            {
                                                                                <li>
                                                                                    <time data-local-time datetime="@DomainsModel.FormatIso(item.Timestamp)">@DomainsModel.FormatUtc(item.Timestamp)</time>
                                                                                    <div>
                                                                                        <strong>@item.Label</strong>
                                                                                        <small>@item.Detail</small>
                                                                                        @if (item.NextAttemptAt is not null)
                                                                                        {
                                                                                            <small>Nächster Versuch: <time data-local-time datetime="@DomainsModel.FormatIso(item.NextAttemptAt)">@DomainsModel.FormatUtc(item.NextAttemptAt)</time></small>
                                                                                        }
                                                                                    </div>
                                                                                </li>
                                                                            }
                                                                        </ol>
                                                                    </article>
                                                                }
                                                            </div>
                                                        </section>
                                                    }
                                                    else
                                                    {
                                                        <p class="certificate-no-events">Keine passenden Zertifikatsereignisse in den verfügbaren Caddy-Logdateien erkannt.</p>
                                                    }

                                                    @if (certificate.Requested && lifecycle.Applied)
                                                    {
                                                        <form method="post" asp-page-handler="RetryCertificate" class="certificate-retry-form" data-confirm-certificate-retry>
                                                            <input type="hidden" name="domainId" value="@domain.Id" />
                                                            <input type="hidden" name="certificateName" value="@certificate.Name" />
                                                            <div>
                                                                <strong>Force-Retry</strong>
                                                                <small>Validiert die aktive Konfiguration und führt <code>caddy reload --force</code> aus. Zertifikate, Volumes und Container werden nicht gelöscht.</small>
                                                            </div>
                                                            <button class="button button--compact button--quiet" type="submit" disabled="@(lifecycle.State == "in-progress")">@(lifecycle.State == "in-progress" ? "Versuch läuft" : "Jetzt erneut anstoßen")</button>
                                                        </form>
                                                    }

                                                    @if (lifecycle.Tips.Count > 0)
                                                    {
                                                        <section class="certificate-tips">
                                                            <h3>Prüfschritte und Hinweise</h3>
                                                            <ul>
                                                                @foreach (var tip in lifecycle.Tips)
                                                                {
                                                                    <li>@tip</li>
                                                                }
                                                            </ul>
                                                        </section>
                                                    }
                                                </div>
                                            </details>
                                        </article>
                                    }
                                }
                            </div>
                        </td>
                        <td data-label="Routen"><strong>@domain.RouteCount</strong><small>verwaltete Route(n)</small></td>
                        <td data-label="Aktionen" class="table-actions">
                            @if (!domain.IsDefault)
                            {
                                <form method="post" asp-page-handler="Default">
                                    <input type="hidden" name="domainId" value="@domain.Id" />
                                    <button class="button button--compact button--quiet" type="submit">Als Standard</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Domains.Count == 0)
                {
                    <tr><td colspan="5" class="empty-state">Noch keine Domain angelegt.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </article>

    <aside class="workbench">
        <header class="workbench-header">
            <div><p class="eyebrow">Neu</p><h2>Domain hinzufügen</h2></div>
        </header>
        <div class="workbench-body">
            <form method="post" asp-page-handler="Create" class="form-stack" data-domain-form>
                <label class="field">
                    <span class="field-label">Domain</span>
                    <input asp-for="Input.Name" placeholder="example.com" autocomplete="off" />
                    <span asp-validation-for="Input.Name" class="field-error"></span>
                </label>
                <label class="field">
                    <span class="field-label">Anzeigename</span>
                    <input asp-for="Input.DisplayName" placeholder="Example" autocomplete="off" />
                    <small>Optional. Standard ist der Domainname.</small>
                </label>
                <label class="field">
                    <span class="field-label">DNS-Provider</span>
                    <select asp-for="Input.DnsProviderId">
                        <option value="">Später zuordnen</option>
                        @foreach (var provider in Model.Providers)
                        {
                            <option value="@provider.Id">@provider.Label · @provider.ProviderType</option>
                        }
                    </select>
                    <small>Für Wildcard erforderlich. Die Domain kann trotzdem sicher als blockierter Entwurf gespeichert werden.</small>
                </label>
                <label class="check certificate-choice">
                    <input asp-for="Input.RequestWildcardCertificate" data-certificate-choice />
                    <span><strong>Wildcard-Zertifikat</strong><small><code>*.example.com</code> für direkte Subdomains.</small></span>
                </label>
                <label class="check certificate-choice">
                    <input asp-for="Input.RequestBaseCertificate" data-certificate-choice />
                    <span><strong>Basisdomain-Zertifikat</strong><small><code>example.com</code> ist nicht im Wildcard-Zertifikat enthalten.</small></span>
                </label>
                <div class="notice notice--warning" data-certificate-warning hidden>Mindestens eine Zertifikatsart auswählen.</div>
                <label class="check">
                    <input asp-for="Input.MakeDefault" />
                    <span><strong>Als Standarddomain verwenden</strong><small>Neue Routen wählen diese Domain zuerst.</small></span>
                </label>
                <div class="safe-apply-note">
                    <strong>Nur Entwurf</strong>
                    <span>Das Anlegen verändert Caddy nicht. Beschaffung startet erst nach Vorschau, Validierung und Apply.</span>
                </div>
                <button class="button button--primary" type="submit">Domain sicher anlegen</button>
            </form>
        </div>
    </aside>
</section>

<section class="workbench operations-section">
    <header class="workbench-header"><div><p class="eyebrow">Statusmodell</p><h2>Was die Anzeigen bedeuten</h2></div></header>
    <div class="workbench-body certificate-legend">
        <span><i class="status-dot status-dot--neutral"></i><strong>Bereit für Apply</strong>Nur im Entwurf.</span>
        <span><i class="status-dot status-dot--warning"></i><strong>Läuft oder geplant</strong>Caddy arbeitet oder hat einen neuen Versuch angekündigt.</span>
        <span><i class="status-dot status-dot--ok"></i><strong>Vorhanden</strong>Zertifikat im Caddy-Speicher gefunden und gültig.</span>
        <span><i class="status-dot status-dot--danger"></i><strong>Fehler oder blockiert</strong>Letzter Versuch, Provider oder Konfiguration verhindert den Erfolg.</span>
    </div>
</section>

@section Scripts {
    <script src="~/js/certificate-diagnostics.js" asp-append-version="true" defer></script>
}
