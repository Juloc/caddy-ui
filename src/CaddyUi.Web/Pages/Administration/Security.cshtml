@page
@model CaddyUi.Web.Pages.Administration.SecurityModel
@{
    ViewData["Title"] = T["Security"];
}

<section class="page-heading">
    <div>
        <p class="eyebrow">@T["Account"]</p>
        <h1>@T["TOTP and recovery codes"]</h1>
        <p class="page-description">@T["TOTP remains optional while CADDY_UI_REQUIRE_TOTP=false is configured. Public installations display a warning."]</p>
    </div>
    <span class="status-badge @(Model.TotpEnabled ? "status-badge--ok" : "status-badge--warning")">
        @(Model.TotpEnabled ? T["TOTP enabled"] : T["TOTP disabled"])
    </span>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice notice--ok">@Model.StatusMessage</div>
}

@if (Model.RecoveryCodes.Count > 0)
{
    <section class="panel">
        <header class="panel-header">
            <div>
                <p class="eyebrow">@T["Shown once"]</p>
                <h2>@T["Recovery codes"]</h2>
            </div>
        </header>
        <div class="panel-body">
            <p>@T["These codes are shown only now. Each code can be used exactly once."]</p>
            <div class="code-grid">
                @foreach (var code in Model.RecoveryCodes)
                {
                    <code>@code</code>
                }
            </div>
        </div>
    </section>
}

<section class="workspace-grid">
    <article class="panel panel--wide">
        <header class="panel-header">
            <div>
                <p class="eyebrow">Authenticator</p>
                <h2>@T["Set up new TOTP"]</h2>
            </div>
        </header>
        <div class="panel-body">
            @if (string.IsNullOrWhiteSpace(Model.SetupSecret))
            {
                <form method="post" asp-page-handler="Begin">
                    <button class="button button--primary" type="submit">@T["Start setup"]</button>
                </form>
            }
            else
            {
                <div class="form-stack">
                    <label>
                        <span>Secret</span>
                        <input value="@Model.SetupSecret" readonly />
                    </label>
                    <label>
                        <span>Provisioning URI</span>
                        <textarea readonly rows="3">@Model.ProvisioningUri</textarea>
                    </label>
                    <form method="post" asp-page-handler="Enable" class="form-stack">
                        <input type="hidden" asp-for="SetupSecret" />
                        <label>
                            <span>@T["Confirm six-digit code"]</span>
                            <input asp-for="VerificationCode" inputmode="numeric" autocomplete="one-time-code" />
                        </label>
                        <button class="button button--primary" type="submit">@T["Enable TOTP"]</button>
                    </form>
                </div>
            }
        </div>
    </article>

    <aside class="panel">
        <header class="panel-header">
            <div>
                <p class="eyebrow">@T["Reset"]</p>
                <h2>@T["Disable TOTP"]</h2>
            </div>
        </header>
        <div class="panel-body">
            <p>@T["All existing recovery codes become invalid."]</p>
            <form method="post" asp-page-handler="Disable">
                @if (Model.TotpEnabled)
                {
                    <button class="button button--danger" type="submit">@T["Disable"]</button>
                }
                else
                {
                    <button class="button button--danger" type="button" disabled>@T["Disable"]</button>
                }
            </form>
        </div>
    </aside>
</section>
