@page "/Setup"
@using CaddyUi.Application.Dns
@model CaddyUi.Web.Pages.Setup.IndexModel
@{
    ViewData["Title"] = "Einrichtung";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Sicherer Assistent</p>
        <h1>DNS, Domain und Route einrichten</h1>
        <p class="page-description">Alle Angaben werden zuerst geprüft und anschließend in einer Transaktion gespeichert. Ein Abbruch oder Fehler hinterlässt keinen halbfertigen Stand.</p>
    </div>
    <span class="status-badge status-badge--ok">Kein direkter Apply</span>
</section>

@if (TempData["SetupMessage"] is string setupMessage)
{
    <div class="notice notice--success">
        <strong>Einrichtung gespeichert</strong>
        <span>@setupMessage</span>
        <div class="page-actions">
            <a class="button button--compact button--quiet" asp-page="/Administration/Domains">Domains prüfen</a>
            <a class="button button--compact button--primary" asp-page="/Routing/Preview">Vorschau öffnen</a>
        </div>
    </div>
}

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<form method="post" class="setup-wizard" data-setup-wizard>
    <section class="workspace-section setup-step">
        <header class="section-header">
            <div><p class="setup-step-number">1</p><h2>DNS-Provider</h2><p>Optional einen vorhandenen Provider verwenden oder mit passenden Feldern neu anlegen.</p></div>
        </header>
        <div class="form-grid form-grid--three">
            <label class="field">
                <span class="field-label">Provider-Konfiguration</span>
                <select asp-for="Input.ProviderMode" data-provider-mode>
                    <option value="new">Neuen Provider anlegen</option>
                    <option value="existing">Vorhandenen Provider verwenden</option>
                    <option value="none">Vorerst ohne Provider</option>
                </select>
                <small>Ohne Provider kann die Domain gespeichert werden. Wildcard-Beschaffung bleibt dann sichtbar blockiert.</small>
            </label>

            <label class="field" data-provider-existing>
                <span class="field-label">Vorhandener Provider</span>
                <select asp-for="Input.ExistingProviderId">
                    <option value="">Bitte auswählen</option>
                    @foreach (var provider in Model.ExistingProviders)
                    {
                        <option value="@provider.Id">@provider.Label · @provider.ProviderType</option>
                    }
                </select>
                <small>Nur aktive Provider werden angeboten.</small>
            </label>

            <label class="field" data-provider-new>
                <span class="field-label">Provider</span>
                <select asp-for="Input.ProviderType" data-provider-type>
                    @foreach (var definition in Model.ProviderDefinitions)
                    {
                        <option value="@definition.Type">@definition.DisplayName</option>
                    }
                </select>
            </label>

            <label class="field" data-provider-new>
                <span class="field-label">Anzeigename</span>
                <input asp-for="Input.ProviderLabel" placeholder="DNS Produktion" autocomplete="off" />
                <small>Nur ein interner Name zur Wiedererkennung.</small>
            </label>
        </div>

        @foreach (var definition in Model.ProviderDefinitions)
        {
            <div class="provider-field-panel" data-provider-fields="@definition.Type">
                <div class="provider-field-heading">
                    <div><strong>@definition.DisplayName</strong><small>@definition.DocumentationHint</small></div>
                    <span class="status-badge status-badge--neutral">@definition.Capabilities</span>
                </div>
                <div class="form-grid form-grid--three">
                    @foreach (var field in definition.Settings)
                    {
                        var fieldName = IndexModel.FieldName(definition.Type, field.Key);
                        <label class="field">
                            <span class="field-label">@field.Label @(field.Required ? "*" : "")</span>
                            <input name="Input.ProviderSettings[@fieldName]" value="@Model.Input.ProviderSettings.GetValueOrDefault(fieldName, field.DefaultValue ?? string.Empty)" autocomplete="off" />
                            <small>@(field.HelpText ?? (field.DefaultValue is null ? "Nicht geheime Provider-Einstellung." : $"Standard: {field.DefaultValue}"))</small>
                        </label>
                    }
                    @foreach (var field in definition.Secrets)
                    {
                        var fieldName = IndexModel.FieldName(definition.Type, field.Key);
                        <label class="field">
                            <span class="field-label">@field.Label @(field.Required ? "*" : "")</span>
                            <input name="Input.ProviderSecretReferences[@fieldName]" value="@Model.Input.ProviderSecretReferences.GetValueOrDefault(fieldName, string.Empty)" placeholder="UMGEBUNGSVARIABLE" autocomplete="off" spellcheck="false" />
                            <small>@field.HelpText</small>
                        </label>
                    }
                    @if (definition.Settings.Count == 0 && definition.Secrets.Count == 0)
                    {
                        <p class="empty-state">Für diesen Provider sind keine zusätzlichen Felder nötig.</p>
                    }
                </div>
            </div>
        }
    </section>

    <section class="workspace-section setup-step">
        <header class="section-header">
            <div><p class="setup-step-number">2</p><h2>Domain und Zertifikate</h2><p>Wildcard und Basisdomain werden bewusst getrennt geplant.</p></div>
        </header>
        <div class="form-grid form-grid--three">
            <label class="field">
                <span class="field-label">Domain</span>
                <input asp-for="Input.DomainName" placeholder="example.com" autocomplete="off" data-domain-name />
                <span asp-validation-for="Input.DomainName" class="field-error"></span>
            </label>
            <label class="field">
                <span class="field-label">Anzeigename</span>
                <input asp-for="Input.DomainDisplayName" placeholder="Example" autocomplete="off" />
                <small>Optional. Standard ist der Domainname.</small>
            </label>
            <label class="check">
                <input asp-for="Input.MakeDefaultDomain" />
                <span><strong>Als Standarddomain verwenden</strong><small>Neue Routen wählen diese Domain zuerst aus.</small></span>
            </label>
            <label class="check certificate-choice">
                <input asp-for="Input.RequestWildcardCertificate" data-certificate-choice />
                <span><strong>Wildcard-Zertifikat beschaffen</strong><small><code>*.example.com</code> deckt genau eine Subdomain-Ebene ab.</small></span>
            </label>
            <label class="check certificate-choice">
                <input asp-for="Input.RequestBaseCertificate" data-certificate-choice />
                <span><strong>Basisdomain einschließen</strong><small><code>example.com</code> ist nicht im Wildcard-Zertifikat enthalten und wird separat angefordert.</small></span>
            </label>
        </div>
        <div class="notice notice--warning" data-certificate-warning hidden>Mindestens eine Zertifikatsart muss ausgewählt sein.</div>
    </section>

    <section class="workspace-section setup-step">
        <header class="section-header">
            <div><p class="setup-step-number">3</p><h2>Erste Route</h2><p>Optional direkt eine geprüfte Route als Entwurf anlegen.</p></div>
        </header>
        <label class="check setup-toggle">
            <input asp-for="Input.CreateRoute" data-route-toggle />
            <span><strong>Route jetzt anlegen</strong><small>Die laufende Caddy-Konfiguration bleibt bis zu Vorschau und Apply unverändert.</small></span>
        </label>

        <div data-route-fields>
            <div class="form-grid form-grid--three">
                <label class="field">
                    <span class="field-label">Routenname</span>
                    <input asp-for="Input.RouteName" placeholder="Mealie" autocomplete="off" />
                </label>
                <label class="field">
                    <span class="field-label">Subdomain</span>
                    <input asp-for="Input.RouteSubdomain" placeholder="mealie" autocomplete="off" data-route-subdomain />
                    <small>Leer verwendet die Basisdomain.</small>
                </label>
                <label class="field">
                    <span class="field-label">Routentyp</span>
                    <select asp-for="Input.RouteKind" data-route-kind>
                        <option value="proxy">Reverse Proxy</option>
                        <option value="redirect">Weiterleitung</option>
                        <option value="static">Statische Antwort</option>
                        @if (Model.AllowCustomRoutes)
                        {
                            <option value="custom">Eigene Caddy-Direktiven</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span class="field-label">Pfad</span>
                    <input asp-for="Input.RoutePathPrefix" placeholder="/" autocomplete="off" />
                </label>
                <label class="field">
                    <span class="field-label">Zertifikat</span>
                    <select asp-for="Input.RouteCertificateMode">
                        <option value="inherit">Domain-Einstellung übernehmen</option>
                        <option value="wildcard">Wildcard erzwingen</option>
                        <option value="individual">Einzelzertifikat erzwingen</option>
                    </select>
                </label>
            </div>

            <div class="route-kind-panel" data-kind-panel="proxy">
                <h3>Reverse Proxy</h3>
                <div class="form-grid form-grid--three">
                    <label class="field">
                        <span class="field-label">Verbindung</span>
                        <select asp-for="Input.UpstreamScheme">
                            <option value="direct">Direkt / Docker-Netz</option>
                            <option value="http">HTTP</option>
                            <option value="https">HTTPS</option>
                        </select>
                    </label>
                    <label class="field">
                        <span class="field-label">Host</span>
                        <input asp-for="Input.UpstreamHost" placeholder="mealie oder 192.168.1.20" autocomplete="off" />
                        <small>Docker-Servicename, Hostname oder IP-Adresse.</small>
                    </label>
                    <label class="field">
                        <span class="field-label">Port</span>
                        <input asp-for="Input.UpstreamPort" type="number" min="1" max="65535" placeholder="9925" />
                        <small>Nur der interne Zielport, kein Host-Port-Mapping nötig.</small>
                    </label>
                </div>
            </div>

            <div class="route-kind-panel" data-kind-panel="redirect">
                <h3>Weiterleitung</h3>
                <div class="form-grid form-grid--two">
                    <label class="field"><span class="field-label">Ziel</span><input asp-for="Input.RedirectTarget" placeholder="https://example.com/neu" /></label>
                    <label class="check"><input asp-for="Input.RedirectPermanent" /><span><strong>Permanent</strong><small>HTTP 308 statt 302.</small></span></label>
                </div>
            </div>

            <div class="route-kind-panel" data-kind-panel="static">
                <h3>Statische Antwort</h3>
                <div class="form-grid form-grid--two">
                    <label class="field"><span class="field-label">HTTP-Status</span><input asp-for="Input.StaticStatusCode" type="number" min="100" max="599" /></label>
                    <label class="field"><span class="field-label">Antworttext</span><textarea asp-for="Input.StaticBody" rows="4"></textarea></label>
                </div>
            </div>

            @if (Model.AllowCustomRoutes)
            {
                <div class="route-kind-panel" data-kind-panel="custom">
                    <h3>Eigene Caddy-Direktiven</h3>
                    <label class="field"><span class="field-label">Direktiven</span><textarea asp-for="Input.CustomSnippet" rows="10" class="code-editor"></textarea><small>Keine Site-Blöcke oder Secrets. Die Servervalidierung blockiert unsichere Eingaben.</small></label>
                </div>
            }
        </div>
    </section>

    <section class="workspace-section setup-review">
        <header class="section-header"><div><p class="setup-step-number">4</p><h2>Prüfen und speichern</h2><p>Bis zum Klick auf Speichern wurde nichts verändert.</p></div></header>
        <dl class="setup-summary">
            <div><dt>Provider</dt><dd data-summary-provider>–</dd></div>
            <div><dt>Domain</dt><dd data-summary-domain>–</dd></div>
            <div><dt>Zertifikate</dt><dd data-summary-certificates>–</dd></div>
            <div><dt>Route</dt><dd data-summary-route>–</dd></div>
        </dl>
        <div class="safe-apply-note">
            <strong>Sicherheitsablauf</strong>
            <span>Validieren → Provider, Domain und Route atomisch speichern → Vorschau → Caddy validieren → Apply mit Rollback.</span>
        </div>
    </section>

    <footer class="editor-actionbar">
        <div><strong>Keine Teilstände.</strong><span>Bei jedem Fehler wird die gesamte Einrichtung zurückgerollt.</span></div>
        <div class="page-actions">
            <a class="button button--quiet" asp-page="/Index">Abbrechen</a>
            <button class="button button--primary" type="submit">Einrichtung sicher speichern</button>
        </div>
    </footer>
</form>

<script>
(() => {
    const wizard = document.querySelector('[data-setup-wizard]');
    if (!wizard) return;

    const providerMode = wizard.querySelector('[data-provider-mode]');
    const providerType = wizard.querySelector('[data-provider-type]');
    const routeToggle = wizard.querySelector('[data-route-toggle]');
    const routeKind = wizard.querySelector('[data-route-kind]');
    const certificateChoices = [...wizard.querySelectorAll('[data-certificate-choice]')];

    const update = () => {
        const mode = providerMode.value;
        wizard.querySelectorAll('[data-provider-new]').forEach(item => item.hidden = mode !== 'new');
        wizard.querySelectorAll('[data-provider-existing]').forEach(item => item.hidden = mode !== 'existing');
        wizard.querySelectorAll('[data-provider-fields]').forEach(item => {
            item.hidden = mode !== 'new' || item.dataset.providerFields !== providerType.value;
        });

        const hasRoute = routeToggle.checked;
        wizard.querySelector('[data-route-fields]').hidden = !hasRoute;
        wizard.querySelectorAll('[data-kind-panel]').forEach(item => {
            item.hidden = !hasRoute || item.dataset.kindPanel !== routeKind.value;
        });

        const anyCertificate = certificateChoices.some(item => item.checked);
        wizard.querySelector('[data-certificate-warning]').hidden = anyCertificate;

        const providerText = mode === 'none'
            ? 'Später einrichten'
            : mode === 'existing'
                ? wizard.querySelector('[name="Input.ExistingProviderId"]')?.selectedOptions[0]?.textContent || 'Nicht gewählt'
                : providerType.selectedOptions[0]?.textContent || providerType.value;
        const domain = wizard.querySelector('[data-domain-name]').value || 'Noch nicht angegeben';
        const certificates = certificateChoices
            .filter(item => item.checked)
            .map(item => item.name.endsWith('WildcardCertificate') ? `*.${domain}` : domain)
            .join(' + ') || 'Keine Auswahl';
        const subdomain = wizard.querySelector('[data-route-subdomain]').value.trim();
        const routeHost = subdomain ? `${subdomain}.${domain}` : domain;

        wizard.querySelector('[data-summary-provider]').textContent = providerText.trim();
        wizard.querySelector('[data-summary-domain]').textContent = domain;
        wizard.querySelector('[data-summary-certificates]').textContent = certificates;
        wizard.querySelector('[data-summary-route]').textContent = hasRoute
            ? `${routeHost} · ${routeKind.selectedOptions[0]?.textContent || routeKind.value}`
            : 'Keine Route';
    };

    wizard.addEventListener('input', update);
    wizard.addEventListener('change', update);
    update();
})();
</script>
