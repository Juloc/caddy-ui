@page "/__caddy_ui_auth/login"
@model CaddyUi.Web.Pages.Portal.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@Model.GroupName · Geschützter Zugriff</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-card">
        <div class="auth-brand">
            <span class="brand-mark" aria-hidden="true">C</span>
            <div>
                <strong>Caddy Access Portal</strong>
                <span>Geschützte Anwendung</span>
            </div>
        </div>
        <div>
            <p class="eyebrow">Zugriffsgruppe</p>
            <h1>@Model.GroupName</h1>
            <p class="page-description">Diese Anwendung erfordert eine gültige Portal-Sitzung für die zugeordnete Gruppe.</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <form method="post" class="form-stack">
            <input type="hidden" asp-for="Group" />
            <input type="hidden" asp-for="ReturnTo" />
            <label>
                <span>Benutzername</span>
                <input asp-for="Input.Username" autocomplete="username" autofocus />
            </label>
            <label>
                <span>Passwort</span>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" />
            </label>
            <button class="button button--primary" type="submit">Anmelden</button>
        </form>
    </main>
</body>
</html>
