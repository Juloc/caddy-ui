@page "/__caddy_ui_auth/login"
@model CaddyUi.Web.Pages.Portal.LoginModel
@{
    Layout = null;
    var culture = global::System.Globalization.CultureInfo.CurrentUICulture.Name;
}
<!DOCTYPE html>
<html lang="@culture" data-theme="system">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@Model.GroupName · @T["Protected access"]</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-card">
        <div class="auth-brand">
            <span class="brand-mark" aria-hidden="true">C</span>
            <div>
                <strong>Caddy Access Portal</strong>
                <span>@T["Protected application"]</span>
            </div>
        </div>
        <div>
            <p class="eyebrow">@T["Access group"]</p>
            <h1>@Model.GroupName</h1>
            <p class="page-description">@T["This application requires a valid portal session for the assigned group."]</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <form method="post" class="form-stack">
            <input type="hidden" asp-for="Group" />
            <input type="hidden" asp-for="ReturnTo" />
            <label>
                <span>@T["Username"]</span>
                <input asp-for="Input.Username" autocomplete="username" autofocus />
            </label>
            <label>
                <span>@T["Password"]</span>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" />
            </label>
            <button class="button button--primary" type="submit">@T["Sign in"]</button>
        </form>
    </main>
</body>
</html>
