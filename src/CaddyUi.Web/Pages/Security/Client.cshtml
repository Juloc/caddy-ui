@page "{id:guid}"
@model CaddyUi.Web.Pages.Security.ClientModel
@{
    ViewData["Title"] = T["Client details"];
}

@if (Model.Details is null)
{
    <section class="panel"><div class="panel-body">@T["Client not found."]</div></section>
    return;
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice notice--ok">@Model.StatusMessage</div>
}

<section class="page-heading">
    <div>
        <p class="eyebrow">@T["Client"]</p>
        <h1>@Model.Details.Summary.ClientKey[..Math.Min(Model.Details.Summary.ClientKey.Length, 32)]</h1>
        <p class="page-description">@(Model.Details.Summary.Estimated ? T["Client estimated from proxy data. Not a confirmed person."] : T["A first-party client identifier is available."])</p>
    </div>
    <span class="status-badge @(Model.Details.Summary.RiskLevel == "high" ? "status-badge--warning" : "status-badge--neutral")">
        @Model.Details.Summary.Classification · @T["Score"] @Model.Details.Summary.AutomationScore
    </span>
</section>

<section class="workspace-grid">
    <article class="panel panel--wide">
        <header class="panel-header"><div><p class="eyebrow">@T["Network"]</p><h2>IP Intelligence</h2></div></header>
        <div class="panel-body">
            <dl class="detail-grid">
                <div><dt>@T["Address"]</dt><dd><code>@(Model.Details.Summary.LatestAddress.Length == 0 ? "–" : Model.Details.Summary.LatestAddress)</code></dd></div>
                <div><dt>@T["Status"]</dt><dd>@(Model.Details.Intelligence.Pending ? T["Lookup pending"] : Model.Details.Intelligence.Stale ? T["Cache expired"] : T["current"])</dd></div>
                <div><dt>Scope</dt><dd>@(Model.Details.Intelligence.Result?.Scope.ToString() ?? T["Unknown"])</dd></div>
                <div><dt>ASN</dt><dd>@(Model.Details.Intelligence.Result?.Asn ?? "–")</dd></div>
                <div><dt>Prefix</dt><dd>@(Model.Details.Intelligence.Result?.Prefix ?? "–")</dd></div>
                <div><dt>Holder</dt><dd>@(Model.Details.Intelligence.Result?.Holder ?? "–")</dd></div>
                <div><dt>Registry</dt><dd>@(Model.Details.Intelligence.Result?.Registry ?? "–")</dd></div>
                <div><dt>@T["Source"]</dt><dd>@(Model.Details.Intelligence.Result?.Source ?? "–")</dd></div>
            </dl>
            @if (!string.IsNullOrWhiteSpace(Model.Details.Intelligence.Result?.Error))
            {
                <div class="notice notice--warning">@Model.Details.Intelligence.Result.Error</div>
            }
        </div>
    </article>

    <aside class="panel">
        <header class="panel-header"><div><p class="eyebrow">@T["Action"]</p><h2>@T["Block IP"]</h2></div></header>
        <div class="panel-body">
            @if (User.IsInRole("admin") || User.IsInRole("editor"))
            {
                <form method="post" asp-page-handler="Block" class="form-stack">
                    <input type="hidden" name="id" value="@Model.Details.Summary.Id" />
                    <label><span>@T["Reason"]</span><textarea asp-for="BlockReason" rows="3"></textarea></label>
                    <label><span>@T["Duration in hours"]</span><input asp-for="BlockHours" min="1" max="720" /></label>
                    @if (Model.Details.Summary.LatestAddress.Length == 0)
                    {
                        <button class="button button--danger" type="button" disabled>@T["Block"]</button>
                    }
                    else
                    {
                        <button class="button button--danger" type="submit">@T["Block"]</button>
                    }
                </form>
            }
            else
            {
                <p>@T["Viewers can only inspect blocks."]</p>
            }
        </div>
    </aside>
</section>

<section class="workspace-grid">
    <article class="panel">
        <header class="panel-header"><div><p class="eyebrow">@T["Rule engine"]</p><h2>@T["Reasoning"]</h2></div></header>
        <div class="panel-body">
            @if (Model.Details.AssessmentReasons.Count == 0)
            {
                <p>@T["No assessment is available yet."]</p>
            }
            else
            {
                <ol class="reason-list">
                    @foreach (var reason in Model.Details.AssessmentReasons)
                    {
                        <li><strong>+@reason.Weight · @reason.Code</strong><span>@reason.Message</span></li>
                    }
                </ol>
            }
        </div>
    </article>

    <article class="panel panel--wide">
        <header class="panel-header"><div><p class="eyebrow">@T["History"]</p><h2>@T["IP blocks"]</h2></div></header>
        <div class="panel-body table-wrap">
            <table class="data-table">
                <thead><tr><th>@T["Target"]</th><th>@T["Status"]</th><th>@T["Reason"]</th><th>@T["Expires"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var rule in Model.Details.BlockRules)
                    {
                        <tr>
                            <td><code>@rule.Target</code></td>
                            <td>@rule.ActivationState</td>
                            <td>@rule.Reason</td>
                            <td>@if (rule.ExpiresAt is not null) { <time datetime="@rule.ExpiresAt.Value.ToString("O")" data-local-time>@rule.ExpiresAt.Value.ToString("u")</time> } else { <span>–</span> }</td>
                            <td>
                                @if (rule.ReleasedAt is null && (User.IsInRole("admin") || User.IsInRole("editor")))
                                {
                                    <form method="post" asp-page-handler="Unblock">
                                        <input type="hidden" name="id" value="@Model.Details.Summary.Id" />
                                        <input type="hidden" name="ruleId" value="@rule.Id" />
                                        <input type="hidden" name="unblockReason" value="@T["Manually unblocked from client details"]" />
                                        <button class="button button--quiet" type="submit">@T["Unblock"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>
</section>

<section class="panel panel--wide">
    <header class="panel-header"><div><p class="eyebrow">@T["Latest 100"]</p><h2>@T["Requests"]</h2></div></header>
    <div class="panel-body table-wrap">
        <table class="data-table">
            <thead><tr><th>@T["Time"]</th><th>Host</th><th>@T["Request"]</th><th>@T["Status"]</th><th>@T["Class"]</th><th>@T["Duration"]</th></tr></thead>
            <tbody>
                @foreach (var request in Model.Details.RecentRequests)
                {
                    <tr>
                        <td><time datetime="@request.OccurredAt.ToString("O")" data-local-time>@request.OccurredAt.ToString("u")</time></td>
                        <td>@request.Host</td>
                        <td><code>@request.Method @request.Path</code></td>
                        <td>@request.Status</td>
                        <td>@request.ActorType · @request.RequestType</td>
                        <td>@request.DurationMilliseconds.ToString("0.0") ms</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
