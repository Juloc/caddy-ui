@page
@model CaddyUi.Web.Pages.Operations.BackupModel
@inject CaddyUi.Infrastructure.Operations.OperationsOptions OperationsOptions
@{
    ViewData["Title"] = "Backup & Diagnose";
}
<section class="page-heading"><div><p class="eyebrow">Wiederherstellung</p><h1>Backup &amp; Diagnose</h1><p class="page-description">Backups enthalten einen PostgreSQL-Custom-Dump, redigierte Diagnoseinformationen und vorhandene Caddy-Konfigurationsdateien. Secretwerte werden nicht exportiert.</p></div><div class="page-actions"><a class="button button--quiet" asp-page-handler="Diagnostics">Diagnose herunterladen</a><form method="post" asp-page-handler="Create"><button class="button button--primary" type="submit">Backup erstellen</button></form></div></section>
@if (TempData["Message"] is string message) { <div class="notice notice--success">@message</div> }@if (TempData["Error"] is string error) { <div class="notice notice--warning">@error</div> }
<section class="metric-grid"><article class="metric-card"><span class="metric-label">Speicherort</span><strong class="metric-value metric-value--small">@OperationsOptions.BackupDirectory</strong><span class="metric-detail">nur serverseitig</span></article><article class="metric-card"><span class="metric-label">Aufbewahrung</span><strong class="metric-value">@OperationsOptions.BackupRetentionCount</strong><span class="metric-detail">neueste Archive</span></article><article class="metric-card"><span class="metric-label">Backups</span><strong class="metric-value">@Model.Backups.Count</strong><span class="metric-detail">inklusive fehlgeschlagener Läufe</span></article></section>
<section class="workbench operations-section"><header class="workbench-header"><div><p class="eyebrow">Historie</p><h2>Backup-Artefakte</h2></div></header><div class="workbench-body table-wrap"><table class="data-table"><thead><tr><th>Zeit</th><th>Datei</th><th>Größe</th><th>Digest</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var backup in Model.Backups) { <tr><td>@backup.CreatedAt.ToLocalTime().ToString("G")</td><td><strong>@backup.FileName</strong></td><td>@CaddyUi.Web.Pages.AnalyticsPageModelBase.FormatBytes(backup.SizeBytes)</td><td><code>@(backup.Digest.Length > 16 ? backup.Digest[..16] : backup.Digest)</code></td><td><span class="status-badge @(backup.Status == "ok" ? "status-badge--ok" : "status-badge--warning")">@backup.Status</span>@if (!string.IsNullOrWhiteSpace(backup.Error)) { <small>@backup.Error</small> }</td><td>@if (backup.Status == "ok") { <a class="button button--compact button--quiet" asp-page-handler="Download" asp-route-id="@backup.Id">Herunterladen</a> }</td></tr> }@if (Model.Backups.Count == 0) { <tr><td colspan="6" class="empty-state">Noch keine Backups.</td></tr> }</tbody></table></div></section>
