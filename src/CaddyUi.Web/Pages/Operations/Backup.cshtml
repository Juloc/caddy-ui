@page
@model CaddyUi.Web.Pages.Operations.BackupModel
@inject CaddyUi.Infrastructure.Operations.OperationsOptions OperationsOptions
@{
    ViewData["Title"] = T["Backup and diagnostics"];
}
<section class="page-heading"><div><p class="eyebrow">@T["Recovery"]</p><h1>@T["Backup and diagnostics"]</h1><p class="page-description">@T["Backups contain a PostgreSQL custom dump, redacted diagnostic information, and available Caddy configuration files. Secret values are not exported."]</p></div><div class="page-actions"><a class="button button--quiet" asp-page-handler="Diagnostics">@T["Download diagnostics"]</a><form method="post" asp-page-handler="Create"><button class="button button--primary" type="submit">@T["Create backup"]</button></form></div></section>
@if (TempData["Message"] is string message) { <div class="notice notice--success">@message</div> }@if (TempData["Error"] is string error) { <div class="notice notice--warning">@error</div> }
<section class="metric-grid"><article class="metric-card"><span class="metric-label">@T["Storage location"]</span><strong class="metric-value metric-value--small">@OperationsOptions.BackupDirectory</strong><span class="metric-detail">@T["server-side only"]</span></article><article class="metric-card"><span class="metric-label">@T["Retention"]</span><strong class="metric-value">@OperationsOptions.BackupRetentionCount</strong><span class="metric-detail">@T["newest archives"]</span></article><article class="metric-card"><span class="metric-label">@T["Backups"]</span><strong class="metric-value">@Model.Backups.Count</strong><span class="metric-detail">@T["including failed runs"]</span></article></section>
<section class="workbench operations-section"><header class="workbench-header"><div><p class="eyebrow">@T["History"]</p><h2>@T["Backup artifacts"]</h2></div></header><div class="workbench-body table-wrap"><table class="data-table"><thead><tr><th>@T["Time"]</th><th>@T["File"]</th><th>@T["Size"]</th><th>Digest</th><th>@T["Status"]</th><th></th></tr></thead><tbody>@foreach (var backup in Model.Backups) { <tr><td><time datetime="@backup.CreatedAt.ToString("O")" data-local-time>@backup.CreatedAt.ToString("u")</time></td><td><strong>@backup.FileName</strong></td><td>@CaddyUi.Web.Pages.AnalyticsPageModelBase.FormatBytes(backup.SizeBytes)</td><td><code>@(backup.Digest.Length > 16 ? backup.Digest[..16] : backup.Digest)</code></td><td><span class="status-badge @(backup.Status == "ok" ? "status-badge--ok" : "status-badge--warning")">@backup.Status</span>@if (!string.IsNullOrWhiteSpace(backup.Error)) { <small>@backup.Error</small> }</td><td>@if (backup.Status == "ok") { <a class="button button--compact button--quiet" asp-page-handler="Download" asp-route-id="@backup.Id">@T["Download"]</a> }</td></tr> }@if (Model.Backups.Count == 0) { <tr><td colspan="6" class="empty-state">@T["No backups exist yet."]</td></tr> }</tbody></table></div></section>
