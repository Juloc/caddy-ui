@page
@model CaddyUi.Web.Pages.Operations.NotificationsModel
@{
    ViewData["Title"] = "Benachrichtigungen";
}
<section class="page-heading"><div><p class="eyebrow">Meldungen</p><h1>Benachrichtigungen</h1><p class="page-description">Fehler werden immer dauerhaft in PostgreSQL gespeichert. Externe Kanäle werden zusätzlich und unabhängig voneinander ausgeliefert.</p></div><span class="status-badge status-badge--neutral">@Model.Channels.Count Kanäle</span></section>
@if (TempData["Message"] is string message) { <div class="notice notice--success">@message</div> }@if (TempData["Error"] is string error) { <div class="notice notice--warning">@error</div> }
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<section class="operations-grid operations-grid--sidebar"><article class="workbench"><header class="workbench-header"><div><p class="eyebrow">Konfiguriert</p><h2>Kanäle</h2></div></header><div class="workbench-body table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>Typ</th><th>Status</th><th>Letzter Test</th><th class="table-actions">Aktionen</th></tr></thead><tbody>
@foreach (var channel in Model.Channels) { <tr><td><strong>@channel.Name</strong><small>@(channel.Enabled ? "aktiv" : "deaktiviert")</small></td><td><code>@channel.ChannelType</code></td><td><span class="status-badge @(channel.LastTestStatus == "ok" ? "status-badge--ok" : channel.LastTestStatus == "failed" ? "status-badge--warning" : "status-badge--neutral")">@channel.LastTestStatus</span></td><td>@(channel.LastTestedAt?.ToLocalTime().ToString("g") ?? "–")@if (!string.IsNullOrWhiteSpace(channel.LastTestError)) { <small>@channel.LastTestError</small> }</td><td class="table-actions"><form method="post" asp-page-handler="Test"><input type="hidden" name="channelId" value="@channel.Id" /><button class="button button--compact button--primary" type="submit" disabled="@(!channel.Enabled)">Testen</button></form><form method="post" asp-page-handler="Toggle"><input type="hidden" name="channelId" value="@channel.Id" /><input type="hidden" name="enabled" value="@(!channel.Enabled)" /><button class="button button--compact button--quiet" type="submit">@(channel.Enabled ? "Deaktivieren" : "Aktivieren")</button></form></td></tr> }
@if (Model.Channels.Count == 0) { <tr><td colspan="5" class="empty-state">Noch keine Kanäle.</td></tr> }
</tbody></table></div></article><aside class="workbench"><header class="workbench-header"><div><p class="eyebrow">Neu</p><h2>Kanal hinzufügen</h2></div></header><div class="workbench-body"><form method="post" asp-page-handler="Create" class="form-stack"><label><span>Name</span><input asp-for="Input.Name" /></label><label><span>Typ</span><select asp-for="Input.ChannelType"><option value="webhook">Webhook</option><option value="discord">Discord</option><option value="telegram">Telegram</option><option value="email">E-Mail / SMTP</option></select></label><label><span>Einstellungen als JSON</span><textarea asp-for="Input.ConfigJson" rows="8"></textarea><small>Nur nicht geheime Werte wie URL, Chat-ID, SMTP-Host oder Empfänger.</small></label><label><span>Secret-Referenzen als JSON</span><textarea asp-for="Input.SecretReferencesJson" rows="6"></textarea><small>Nur Umgebungsvariablen oder <code>secret://</code>-Referenzen, keine Tokenwerte.</small></label><button class="button button--primary" type="submit">Kanal anlegen</button></form></div></aside></section>
