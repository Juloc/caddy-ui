@page
@model CaddyUi.Web.Pages.Operations.CutoverModel
@using CaddyUi.Infrastructure.Cutover
@{
    ViewData["Title"] = T["Cutover"];
    static string Badge(CutoverCheckState state) => state switch
    {
        CutoverCheckState.Passed => "status-badge--ok",
        CutoverCheckState.Warning => "status-badge--warning",
        _ => "status-badge--danger",
    };
    string Label(CutoverCheckState state) => state switch
    {
        CutoverCheckState.Passed => T["Passed"],
        CutoverCheckState.Warning => T["Warning"],
        _ => T["Blocked"],
    };
}
<section class="page-heading">
    <div>
        <p class="eyebrow">@T["Migration and rollback"]</p>
        <h1>@T["Production readiness"]</h1>
        <p class="page-description">@T["The page opens immediately. Expensive database, backup, and statistics checks run only after an explicit action and time out after 30 seconds."]</p>
    </div>
    <div class="page-actions">
        <form method="post" asp-page-handler="Compare"><button class="button button--quiet" type="submit">@T["Compare statistics"]</button></form>
        <form method="post" asp-page-handler="Capture"><button class="button button--primary" type="submit">@T["Check readiness now"]</button></form>
    </div>
</section>
@if (TempData["Message"] is string message) { <div class="notice notice--success">@message</div> }
@if (TempData["Error"] is string error) { <div class="notice notice--warning">@error</div> }

@if (Model.Report is null)
{
    <section class="workbench operations-section">
        <header class="workbench-header"><div><p class="eyebrow">@T["Not run yet"]</p><h2>@T["Readiness check"]</h2></div><span class="status-badge status-badge--neutral">@T["Manual"]</span></header>
        <div class="workbench-body">
            <p class="empty-state">@T["Select Check readiness now to verify PostgreSQL, migrations, the legacy backup, logs, routes, domains, and rollback requirements. Opening the page does not execute expensive queries."]</p>
        </div>
    </section>
}
else
{
    @if (!Model.Report.IsReady) { <div class="notice notice--warning"><strong>@T["Cutover blocked."]</strong> @T["{0} checks must be resolved before a maintenance window.", Model.Report.BlockedCount]</div> }
    <section class="metric-grid">
        <article class="metric-card"><span class="metric-label">@T["Readiness"]</span><strong class="metric-value">@(Model.Report.IsReady ? T["Ready"] : T["Blocked"])</strong><span class="metric-detail">@T["{0} blockers · {1} warnings", Model.Report.BlockedCount, Model.Report.WarningCount]</span></article>
        <article class="metric-card"><span class="metric-label">@T["Data"]</span><strong class="metric-value">@Model.Report.Inventory.Requests</strong><span class="metric-detail">@T["{0} requests · {1} page views", Model.Report.Inventory.Requests, Model.Report.Inventory.PageViews]</span></article>
        <article class="metric-card"><span class="metric-label">@T["Configuration"]</span><strong class="metric-value">@Model.Report.Inventory.Routes</strong><span class="metric-detail">@T["{0} routes · {1} domains", Model.Report.Inventory.Routes, Model.Report.Inventory.Domains]</span></article>
        <article class="metric-card"><span class="metric-label">@T["Legacy source"]</span><strong class="metric-value metric-value--small">@(string.IsNullOrWhiteSpace(Model.Report.Inventory.LegacySourceDigest) ? T["unavailable"] : Model.Report.Inventory.LegacySourceDigest[..12])</strong><span class="metric-detail">SHA-256 · @Model.Report.Inventory.LegacySourceSizeBytes @T["bytes"]</span></article>
    </section>
    <section class="workbench operations-section">
        <header class="workbench-header"><div><p class="eyebrow">Gate</p><h2>@T["Production readiness"]</h2></div><span class="status-badge @(Model.Report.IsReady ? "status-badge--ok" : "status-badge--danger")">@(Model.Report.IsReady ? T["Ready"] : T["Blocked"])</span></header>
        <div class="workbench-body table-wrap">
            <table class="data-table">
                <thead><tr><th>@T["Status"]</th><th>@T["Check"]</th><th>@T["Result"]</th><th>@T["Remediation"]</th></tr></thead>
                <tbody>
                @foreach (var check in Model.Report.Checks)
                {
                    <tr>
                        <td><span class="status-badge @Badge(check.State)">@Label(check.State)</span></td>
                        <td><strong>@check.Title</strong><small><code>@check.Code</code></small></td>
                        <td>@check.Detail</td>
                        <td>@if (!string.IsNullOrWhiteSpace(check.Remediation)) { <span>@check.Remediation</span> } else { <span class="is-muted">@T["None"]</span> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="operations-grid operations-grid--sidebar">
    <article class="workbench operations-section">
        <header class="workbench-header"><div><p class="eyebrow">@T["Same UTC window"]</p><h2>@T["Statistics comparison"]</h2></div>@if (Model.Comparison is not null) { <span class="status-badge @(Model.Comparison.IsWithinTolerance ? "status-badge--ok" : "status-badge--danger")">@(Model.Comparison.IsWithinTolerance ? T["Within tolerance"] : T["Difference"])</span> }</header>
        <div class="workbench-body table-wrap">
            @if (Model.Comparison is null)
            {
                <p class="empty-state">@T["The comparison runs only after an explicit action. Required legacy snapshot:"] <code>@Model.Options.LegacyStatisticsPath</code></p>
            }
            else
            {
                <table class="data-table"><thead><tr><th>@T["Metric"]</th><th>Legacy</th><th>.NET</th><th>@T["Difference"]</th><th>@T["Status"]</th></tr></thead><tbody>
                @foreach (var metric in Model.Comparison.Metrics)
                {
                    <tr><td><strong>@metric.Metric</strong></td><td>@metric.LegacyValue</td><td>@metric.DotNetValue</td><td>@metric.AbsoluteDifference · @metric.DifferencePercent.ToString("F2") %</td><td><span class="status-badge @(metric.WithinTolerance ? "status-badge--ok" : "status-badge--danger")">@(metric.WithinTolerance ? "OK" : T["Review"])</span></td></tr>
                }
                </tbody></table>
            }
        </div>
    </article>
    <aside class="workbench operations-section">
        <header class="workbench-header"><div><p class="eyebrow">@T["Operations"]</p><h2>@T["Maintenance window"]</h2></div></header>
        <div class="workbench-body definition-list">
            <div><span>@T["Cutover approved"]</span><strong>@(Model.Options.Enabled ? T["yes"] : T["no"])</strong></div>
            <div><span>@T["Minimum observation time"]</span><strong>@Model.Options.MinimumShadowHours h</strong></div>
            <div><span>@T["Maximum difference"]</span><strong>@Model.Options.MaximumMetricDifferencePercent.ToString("F1") %</strong></div>
            <div><span>@T["Admin port"]</span><strong>:@Model.Options.AdminPort</strong></div>
            <div><span>@T["Portal port"]</span><strong>:@Model.Options.PortalPort</strong></div>
            <div><span>@T["Manifest directory"]</span><strong class="value-cell">@Model.Options.ManifestDirectory</strong></div>
        </div>
    </aside>
</section>
<section class="workbench operations-section">
    <header class="workbench-header"><div><p class="eyebrow">@T["Order"]</p><h2>@T["Controlled cutover"]</h2></div></header>
    <div class="workbench-body"><ol class="reason-list"><li>@T["Pause writes briefly and create a consistent backup of the old SQLite file."]</li><li>@T["Run the final import and verification against exactly that backup."]</li><li>@T["Store the PostgreSQL backup and readiness and statistics manifests."]</li><li>@T["Switch the admin and portal upstreams to ports {0} and {1} in a controlled operation.", Model.Options.AdminPort, Model.Options.PortalPort]</li><li>@T["Verify login, TOTP, portal, route preview, DNS, certificates, requests, and page views."]</li><li>@T["Leave workers and write modes enabled only after successful acceptance."]</li><li>@T["If a blocker occurs, restore the previous Caddy snapshot and old data source."]</li></ol></div>
</section>
