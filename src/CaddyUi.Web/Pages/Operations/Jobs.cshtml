@page
@model CaddyUi.Web.Pages.Operations.JobsModel
@inject CaddyUi.Infrastructure.Operations.OperationsOptions OperationsOptions
@{
    ViewData["Title"] = "Jobs";
}
<section class="page-heading"><div><p class="eyebrow">Automatisierung</p><h1>Jobs</h1><p class="page-description">PostgreSQL-basierte Jobs laufen serialisierbar mit Sperre, Run-Historie und eindeutiger Correlation-ID. Der Worker ist standardmäßig deaktiviert.</p></div><span class="status-badge @(OperationsOptions.WorkerEnabled ? "status-badge--ok" : "status-badge--neutral")">Worker: @(OperationsOptions.WorkerEnabled ? "aktiv" : "deaktiviert")</span></section>
@if (TempData["Message"] is string message) { <div class="notice notice--success">@message</div> }
@if (TempData["Error"] is string error) { <div class="notice notice--warning">@error</div> }
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<section class="operations-grid operations-grid--sidebar">
<article class="workbench"><header class="workbench-header"><div><p class="eyebrow">Konfiguriert</p><h2>@Model.Jobs.Count Jobs</h2></div></header><div class="workbench-body table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>Typ</th><th>Intervall</th><th>Nächster Lauf</th><th>Status</th><th class="table-actions">Aktionen</th></tr></thead><tbody>
@foreach (var job in Model.Jobs) { <tr><td><strong>@job.Name</strong><small>@(job.Enabled ? "aktiv" : "deaktiviert")</small></td><td><code>@job.JobType</code></td><td>@job.IntervalSeconds s</td><td>@job.NextRunAt.ToLocalTime().ToString("g")</td><td><span class="status-badge @(job.LastStatus == "ok" ? "status-badge--ok" : job.LastStatus == "failed" ? "status-badge--warning" : "status-badge--neutral")">@job.LastStatus</span>@if (!string.IsNullOrWhiteSpace(job.LastError)) { <small>@job.LastError</small> }</td><td class="table-actions"><form method="post" asp-page-handler="Run"><input type="hidden" name="jobId" value="@job.Id" /><button class="button button--compact button--primary" type="submit">Jetzt ausführen</button></form><form method="post" asp-page-handler="Toggle"><input type="hidden" name="jobId" value="@job.Id" /><input type="hidden" name="enabled" value="@(!job.Enabled)" /><button class="button button--compact button--quiet" type="submit">@(job.Enabled ? "Deaktivieren" : "Aktivieren")</button></form></td></tr> }
@if (Model.Jobs.Count == 0) { <tr><td colspan="6" class="empty-state">Noch keine Jobs.</td></tr> }
</tbody></table></div></article>
<aside class="workbench"><header class="workbench-header"><div><p class="eyebrow">Neu</p><h2>Job anlegen</h2></div></header><div class="workbench-body"><form method="post" asp-page-handler="Create" class="form-stack"><label><span>Name</span><input asp-for="Input.Name" /></label><label><span>Typ</span><select asp-for="Input.JobType"><option value="health">Healthchecks</option><option value="ddns">Alle DDNS-Ziele</option><option value="provider-test">Provider-Test</option><option value="backup">Backup</option></select></label><label><span>Intervall in Sekunden</span><input asp-for="Input.IntervalSeconds" type="number" min="60" max="604800" /></label><label><span>Konfiguration als JSON</span><textarea asp-for="Input.ConfigJson" rows="7"></textarea><small>Provider-Test: <code>{"provider_id":"…","domain":"example.com"}</code>. Andere Typen verwenden <code>{}</code>.</small></label><button class="button button--primary" type="submit">Job anlegen</button></form></div></aside>
</section>
<section class="workbench operations-section"><header class="workbench-header"><div><p class="eyebrow">Ausführungshistorie</p><h2>Letzte Läufe</h2></div></header><div class="workbench-body table-wrap"><table class="data-table"><thead><tr><th>Start</th><th>Job</th><th>Status</th><th>Meldung</th><th>Correlation-ID</th></tr></thead><tbody>@foreach (var run in Model.Runs) { <tr><td>@run.StartedAt.ToLocalTime().ToString("G")</td><td>@run.JobName</td><td><span class="status-badge @(run.Status == "ok" ? "status-badge--ok" : run.Status == "failed" ? "status-badge--warning" : "status-badge--neutral")">@run.Status</span></td><td>@run.Message</td><td><code>@run.CorrelationId</code></td></tr> }@if (Model.Runs.Count == 0) { <tr><td colspan="5" class="empty-state">Noch keine Jobläufe.</td></tr> }</tbody></table></div></section>
