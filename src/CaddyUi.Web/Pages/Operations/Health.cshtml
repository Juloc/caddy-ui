@page
@model CaddyUi.Web.Pages.Operations.HealthModel
@{
    ViewData["Title"] = "Healthchecks";
}
<section class="page-heading"><div><p class="eyebrow">Erreichbarkeit</p><h1>Healthchecks</h1><p class="page-description">Öffentliche URLs und interne Upstreams werden getrennt geprüft. Statusbereich, Timeout und Verlauf bleiben pro Ziel nachvollziehbar.</p></div><span class="status-badge status-badge--neutral">@Model.Targets.Count Ziele</span></section>
@if (TempData["Message"] is string message) { <div class="notice notice--success">@message</div> }@if (TempData["Error"] is string error) { <div class="notice notice--warning">@error</div> }
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<section class="operations-grid operations-grid--sidebar"><article class="workbench"><header class="workbench-header"><div><p class="eyebrow">Ziele</p><h2>Aktueller Zustand</h2></div></header><div class="workbench-body table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>URL</th><th>Erwartet</th><th>Letzte Prüfung</th><th>Status</th><th class="table-actions">Aktionen</th></tr></thead><tbody>
@foreach (var target in Model.Targets) { <tr><td><strong>@target.Name</strong><small>@target.TargetType</small></td><td class="value-cell"><code>@target.Url</code></td><td>@target.ExpectedStatusMin–@target.ExpectedStatusMax · @target.TimeoutSeconds s</td><td>@(target.LastCheckedAt?.ToLocalTime().ToString("g") ?? "–")<small>@(target.LastDurationMilliseconds is double duration ? $"{duration:N0} ms" : "")</small></td><td><span class="status-badge @(target.LastStatus == "healthy" ? "status-badge--ok" : target.LastStatus == "unhealthy" ? "status-badge--warning" : "status-badge--neutral")">@target.LastStatus</span>@if (!string.IsNullOrWhiteSpace(target.LastError)) { <small>@target.LastError</small> }</td><td class="table-actions"><form method="post" asp-page-handler="Run"><input type="hidden" name="targetId" value="@target.Id" /><button class="button button--compact button--primary" type="submit" disabled="@(!target.Enabled)">Prüfen</button></form><form method="post" asp-page-handler="Toggle"><input type="hidden" name="targetId" value="@target.Id" /><input type="hidden" name="enabled" value="@(!target.Enabled)" /><button class="button button--compact button--quiet" type="submit">@(target.Enabled ? "Deaktivieren" : "Aktivieren")</button></form></td></tr> }
@if (Model.Targets.Count == 0) { <tr><td colspan="6" class="empty-state">Noch keine Health-Ziele.</td></tr> }
</tbody></table></div></article><aside class="workbench"><header class="workbench-header"><div><p class="eyebrow">Neu</p><h2>Ziel hinzufügen</h2></div></header><div class="workbench-body"><form method="post" asp-page-handler="Create" class="form-stack"><label><span>Name</span><input asp-for="Input.Name" /></label><label><span>Typ</span><select asp-for="Input.TargetType"><option value="public">Öffentlich</option><option value="upstream">Interner Upstream</option></select></label><label><span>HTTP(S)-URL</span><input asp-for="Input.Url" placeholder="https://app.example.com/health" /></label><div class="form-grid form-grid--two"><label><span>Status von</span><input asp-for="Input.ExpectedStatusMin" type="number" /></label><label><span>Status bis</span><input asp-for="Input.ExpectedStatusMax" type="number" /></label></div><label><span>Timeout in Sekunden</span><input asp-for="Input.TimeoutSeconds" type="number" min="1" max="120" /></label><button class="button button--primary" type="submit">Ziel anlegen</button></form></div></aside></section>
