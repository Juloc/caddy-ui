@page "/About"
@model AboutModel
@{
    ViewData["Title"] = "Über Caddy UI";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Anwendung</p>
        <h1>Über Caddy UI</h1>
        <p class="page-description">Produkt-, Laufzeit- und Betriebsinformationen an einem zentralen Ort.</p>
    </div>
    <span class="status-badge status-badge--ok">Version @Model.Product.Version</span>
</section>

<section class="workspace-grid about-grid">
    <article class="panel">
        <header class="panel-header"><div><p class="eyebrow">Produkt</p><h2>@Model.Product.Product</h2></div></header>
        <div class="panel-body definition-list">
            <div><span>Version</span><strong>@Model.Product.Version</strong></div>
            <div><span>Laufzeit</span><strong>@Model.Product.Runtime</strong></div>
            <div><span>Umgebung</span><strong>@Model.EnvironmentName</strong></div>
            <div><span>Datenbank</span><strong>PostgreSQL</strong></div>
        </div>
    </article>

    <article class="panel">
        <header class="panel-header"><div><p class="eyebrow">Betrieb</p><h2>Aktive Modi</h2></div></header>
        <div class="panel-body definition-list">
            <div><span>Routen schreiben</span><strong>@Model.Routing.WriteMode</strong></div>
            <div><span>DNS schreiben</span><strong>@Model.Operations.DnsWriteMode</strong></div>
            <div><span>Hintergrundjobs</span><strong>@(Model.Operations.WorkerEnabled ? "Aktiv" : "Deaktiviert")</strong></div>
            <div><span>Eigene Routen</span><strong>@(Model.Routing.AllowCustomRoutes ? "Erlaubt" : "Deaktiviert")</strong></div>
        </div>
    </article>

    <article class="panel">
        <header class="panel-header"><div><p class="eyebrow">Caddy</p><h2>Integration</h2></div></header>
        <div class="panel-body definition-list">
            <div><span>Portal-Upstream</span><strong><code>@Model.Routing.PortalUpstream</code></strong></div>
            <div><span>DNS-Module</span><strong>@string.Join(", ", Model.Operations.InstalledCaddyDnsModules.OrderBy(module => module))</strong></div>
            <div><span>Provider-Secrets</span><strong><code>@Model.Operations.ProviderSecretDirectory</code></strong></div>
            <div><span>Zertifikatsdaten</span><strong><code>@Model.Operations.CertificateDirectory</code></strong></div>
        </div>
    </article>

    <article class="panel">
        <header class="panel-header"><div><p class="eyebrow">Sicherheit</p><h2>Migration und Rückfall</h2></div></header>
        <div class="panel-body definition-list">
            <div><span>Umschaltung</span><strong>@(Model.Cutover.Enabled ? "Freigegeben" : "Gesperrt")</strong></div>
            <div><span>Admin-Port</span><strong>@Model.Cutover.AdminPort</strong></div>
            <div><span>Portal-Port</span><strong>@Model.Cutover.PortalPort</strong></div>
            <div><span>Manifest-Verzeichnis</span><strong><code>@Model.Cutover.ManifestDirectory</code></strong></div>
        </div>
    </article>
</section>
