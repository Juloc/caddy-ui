{
  "ConnectionStrings": {
    "CaddyUi": "Host=localhost;Port=5432;Database=caddy_ui;Username=caddy_ui;Password=caddy_ui"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "DataProtection": {
    "PersistKeysToPostgreSql": true
  },
  "Localization": {
    "DefaultCulture": "en",
    "SupportedCultures": [
      "en",
      "de"
    ]
  },
  "Analytics": {
    "Enabled": false,
    "LogPaths": [],
    "BatchSize": 1000,
    "PollIntervalMilliseconds": 1000,
    "SessionIdleMinutes": 30,
    "PageLoadWindowSeconds": 15,
    "RawRequestRetentionDays": 30,
    "PageViewRetentionDays": 180,
    "HourlyRetentionDays": 90,
    "DailyRetentionDays": 730,
    "MaintenanceIntervalMinutes": 360
  },
  "IpSecurity": {
    "IntelligenceEnabled": false,
    "RipeStatBaseAddress": "https://stat.ripe.net/",
    "ProviderTimeoutSeconds": 5,
    "SuccessCacheHours": 24,
    "FailureCacheMinutes": 10,
    "RefreshBatchSize": 20,
    "RefreshIntervalSeconds": 15,
    "DiscoveryLookbackMinutes": 60,
    "RiskAssessmentEnabled": false,
    "RiskWindowMinutes": 30,
    "RiskRefreshMinutes": 5,
    "RiskBatchSize": 100,
    "BlockWriteMode": "disabled",
    "BlocklistPath": "/tmp/caddy-ui-blocklist.shadow",
    "MaximumBlockHours": 720
  },
  "Routing": {
    "WriteMode": "disabled",
    "ManagedFragmentPath": "/data/caddy-ui/generated/managed-routes.caddy",
    "ShadowFragmentPath": "/data/caddy-ui/shadow/managed-routes.caddy",
    "RootConfigPath": "/etc/caddy/Caddyfile",
    "CaddyBinaryPath": "/usr/bin/caddy",
    "PortalUpstream": "127.0.0.1:8099",
    "CommandTimeoutSeconds": 30,
    "AllowCustomRoutes": false
  },
  "Operations": {
    "WorkerEnabled": false,
    "DnsWriteMode": "disabled",
    "PollIntervalSeconds": 15,
    "ProviderTimeoutSeconds": 10,
    "HealthHistoryDays": 30,
    "BackupDirectory": "/data/caddy-ui/backups",
    "DiagnosticsDirectory": "/data/caddy-ui/diagnostics",
    "PgDumpBinary": "/usr/bin/pg_dump",
    "BackupRetentionCount": 14,
    "InstalledCaddyDnsModules": "netcup",
    "PublicIpv4Services": [
      "https://api.ipify.org",
      "https://ipv4.icanhazip.com"
    ],
    "PublicIpv6Services": [
      "https://api64.ipify.org",
      "https://ipv6.icanhazip.com"
    ]
  },
  "Cutover": {
    "Enabled": false,
    "LegacySqlitePath": "/data/caddy-ui/legacy/caddy-ui.db",
    "LegacyStatisticsPath": "/data/caddy-ui/cutover/legacy-statistics.json",
    "ManifestDirectory": "/data/caddy-ui/cutover",
    "MinimumShadowHours": 24,
    "MaximumBackupAgeHours": 24,
    "MaximumMetricDifferencePercent": 5,
    "AdminPort": 8098,
    "PortalPort": 8099
  },
  "Security": {
    "PublicOrigin": "",
    "AdminProxySecret": "",
    "PortalProxySecret": "",
    "RequireTotp": false
  },
  "Authentication": {
    "BootstrapUsername": "admin",
    "BootstrapPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
